@{
    Layout = "_LayoutFreelancer";
    ViewData["Title"] = "Dashboard";
}

@model Freelancing.Models.FreelancerDashboard

<div class="p-4 sm:ml-64">
    <div class="pt-2 mt-20">
        <div class="block w-full p-6">
            <div class="mb-4">
                <h4 class="text-2xl text-dark font-bold">
                    Hello, @(User.FindFirst("FullName")?.Value ?? "User")
                </h4>
            </div>

            <div class="w-full mb-4 text-left bg-white border border-gray-200 rounded-lg shadow-sm p-4 sm:p-8 dark:bg-gray-800 dark:border-gray-700">
                <h5 class="mb-2 text-3xl font-bold text-gray-900 dark:text-white">Total Completed Projects</h5>
                <div class="flex items-center justify-between">
                    <h5 id="totalProject" class="mb-2 text-3xl font-bold text-gray-900 dark:text-white">@ViewBag.TotalAcceptedProjects</h5>
                </div>
            </div>

            @{
                // Get all active bids (not just 3)
                var allActiveBids = Model.Biddings.Where(b => b.IsAccepted &&
                b.Project != null &&
                b.Project.Status == "Active" &&
                !((HashSet<Guid>)ViewBag.TerminatedProjectIds).Contains(b.Project.Id))
                .ToList();

                var activeProjectsCount = allActiveBids.Count();
                var activeBids = allActiveBids.Take(3).ToList(); // Take only 3 for display

                // Get all sent biddings count
                var allSentBiddings = (Model.Biddings ?? Enumerable.Empty<Freelancing.Models.Entities.Bidding>()).ToList();
                var sentBiddingsCount = allSentBiddings.Count();

                // Get all received feedbacks count
                var allReceivedFeedbacks = (Model.ReceivedFeedbacks ?? new List<Freelancing.Models.Entities.FreelancerFeedback>()).ToList();
                var receivedFeedbacksCount = allReceivedFeedbacks.Count();
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Active Projects</h5>
                        <a asp-action="ActiveProjects" asp-controller="Freelancer" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View Details</a>
                    </div>
                    <div class="flow-root">
                        <h5 class="mb-2 text-3xl font-bold text-gray-900">@activeProjectsCount</h5>
                    </div>
                </div>

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Sent Biddings</h5>
                        <a asp-action="ManageSentBiddings" asp-controller="Freelancer" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View Details</a>
                    </div>
                    <div class="flow-root">
                        <h5 class="mb-2 text-3xl font-bold text-gray-900">@sentBiddingsCount</h5>
                    </div>
                </div>

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Received Feedbacks</h5>
                        <a asp-action="Feedbacks" asp-controller="Freelancer" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View Details</a>
                    </div>
                    <div class="flow-root">
                        <h5 class="mb-2 text-3xl font-bold text-gray-900">@receivedFeedbacksCount</h5>
                    </div>
                </div>

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Spending Summary</h5>
                        <p class="text-sm italic font-light">Based on the budget of all accepted bids</p>
                    </div>
                    <div class="flow-root">
                        <h5 id="totalPostedProject" class="mb-2 text-3xl font-bold text-gray-900"><span class="mr-2">₱</span>@ViewBag.TotalAcceptedBudget</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>