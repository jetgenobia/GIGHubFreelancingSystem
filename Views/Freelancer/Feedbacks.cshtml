@{
    Layout = "_LayoutFreelancer";
    ViewData["Title"] = "Received Feedbacks";
}

@model Freelancing.Models.FreelancerDashboard

<div class="p-4 sm:ml-64">
    <div class="p-4 mt-20">
        <div class="mt-4">
            <div class="block w-full p-6">
                <div class="flex items-center space-x-4">
                    <a href="@Url.Action("Dashboard", "Freelancer")" class="text-blue-600 hover:text-blue-800">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h2 class="text-2xl font-bold text-gray-900">Received Feedbacks</h2>
                </div>

                <div class="w-full max-w mt-4 p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flow-root">
                        <ul role="list" class="divide-y divide-gray-300">
                            @foreach (var feedbacks in Model.ReceivedFeedbacks)
                            {
                                <li class="py-3 sm:py-4">
                                    <div class="flex items-center">
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-gray-900 truncate">
                                                @(
                                                                                            feedbacks.AcceptBidding?.Project != null
                                                                                            ? feedbacks.AcceptBidding.Project.ProjectName
                                                                                            : "Unknown project"
                                                                                            )
                                        </p>
                                        <p class="text-xs text-gray-500">
                                            From: @(feedbacks.AcceptBidding?.Project?.User != null ? $"{feedbacks.AcceptBidding.Project.User.FirstName} {feedbacks.AcceptBidding.Project.User.LastName}" : "Client")
                                            • @feedbacks.Rating star(s)
                                        </p>
                                    </div>
                                    <div class="inline-flex items-center text-base font-semibold text-gray-900">
                                        @{
                                                var projectId = feedbacks.AcceptBidding?.Project?.Id;
                                            }
                                            @if (projectId != null)
                                            {
                                                <a class="text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-6 py-2 me-2 mb-2"
                                                   asp-controller="ManageProjectFreelancer" asp-action="Feedback" asp-route-id="@projectId"> View </a>
                                            }
                                        </div>
                                    </div>
                                </li>
                            }
                            @if (!Model.ReceivedFeedbacks.Any())
                            {
                                <li class="py-3 sm:py-4 text-center">
                                    <div class="text-sm text-gray-500">No feedback received yet.</div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>