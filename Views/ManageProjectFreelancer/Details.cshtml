                                            </g>
                                        </svg>
                                        Waiting for Contract
                                    </div>
                                }
                            </div>
                            <div class="flex justify-center">
                                @{
                                    var contractStatusForDeliverables = ViewBag.ContractStatus as string;
                                    var canSubmitDeliverables = contractStatusForDeliverables == "Active";
                                }

