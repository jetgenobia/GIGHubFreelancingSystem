@using Freelancing.Models.Entities
@model Freelancing.Models.Entities.UserAccount
@using Freelancing.Helpers
@{
    Layout = User.IsInRole("Client") ? "_LayoutClient" : "_LayoutFreelancer";
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName} - Profile";
    var userIsClient = User.IsInRole("Client");
    var userIsFreelancer = User.IsInRole("Freelancer");
    var mentorshipData = ViewBag.MentorshipData as (bool, bool)?;
    var hasCompletedAsMentor = mentorshipData?.Item1 ?? false;
    var hasCompletedAsMentee = mentorshipData?.Item2 ?? false;
    var projects = ViewBag.Projects as List<Project> ?? new List<Project>();
    var biddings = ViewBag.Biddings as List<Bidding> ?? new List<Bidding>();
}

<div class="p-4 sm:ml-64">
    <div class="pt-2 mt-20">
        <div class="mt-1">
            <div class="min-h-screen">
                <!-- Header Section -->
                <div class="bg-white shadow">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                        <div class="flex flex-col md:flex-row items-start space-y-6 md:space-y-0 md:space-x-8">
                            <!-- Profile Picture -->
                            <div class="flex-shrink-0">
                                @if (!string.IsNullOrEmpty(Model.Photo))
                                {
                                    <img src="@Model.Photo" alt="Profile Picture" class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg">
                                }
                                else
                                {
                                    <img src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497" alt="Default Profile Picture" class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg">
                                }
                            </div>

                            <!-- Profile Info -->
                            <div class="flex-1 min-w-0 mt-2">
                                <div class="flex inline-flex items-center">
                                    <div class="flex items-center space-x-4 mb-1">
                                        <h1 class="text-3xl font-bold text-gray-900">@Model.FirstName @Model.LastName</h1>
                                    </div>
                                    @if (ViewBag.IsVerified)
                                    {
                                        <div class="ms-2">
                                            <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                                                <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                                <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                                                <g id="SVGRepo_iconCarrier"> <path fill-rule="evenodd" clip-rule="evenodd" d="M14.6563 5.24291C15.4743 5.88358 16 6.8804 16 8C16 9.11964 15.4743 10.1165 14.6562 10.7572C14.7816 11.7886 14.4485 12.8652 13.6568 13.6569C12.8651 14.4486 11.7885 14.7817 10.7571 14.6563C10.1164 15.4743 9.1196 16 8 16C6.88038 16 5.88354 15.4743 5.24288 14.6562C4.21141 14.7817 3.13481 14.4485 2.34312 13.6568C1.55143 12.8652 1.2183 11.7886 1.34372 10.7571C0.525698 10.1164 0 9.1196 0 8C0 6.88038 0.525715 5.88354 1.34376 5.24288C1.21834 4.21141 1.55147 3.13481 2.34316 2.34312C3.13485 1.55143 4.21145 1.2183 5.24291 1.34372C5.88358 0.525698 6.8804 0 8 0C9.11964 0 10.1165 0.525732 10.7572 1.3438C11.7886 1.21838 12.8652 1.55152 13.6569 2.3432C14.4486 3.13488 14.7817 4.21146 14.6563 5.24291ZM12.2071 6.20711L10.7929 4.79289L7 8.58579L5.20711 6.79289L3.79289 8.20711L7 11.4142L12.2071 6.20711Z" fill="#1C96E8"></path> </g>
                                            </svg>
                                        </div>
                                    }
                                    <!-- Mentorship Badges -->
                                    @if (hasCompletedAsMentor || hasCompletedAsMentee)
                                    {
                                        <div class="flex items-center space-x-2">
                                            @if (hasCompletedAsMentor)
                                            {
                                                <div class="flex items-center">
                                                    <img class="w-6 h-6" src="https://ik.imagekit.io/6txj3mofs/mentor(1).png" alt="Mentor Badge" />
                                                </div>
                                            }
                                            @if (hasCompletedAsMentee)
                                            {
                                                <div class="flex items-center">
                                                    <img class="w-6 h-6" src="https://ik.imagekit.io/6txj3mofs/mentee.png" alt="Mentee Badge" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-gray-600">
                                    @if (!string.IsNullOrEmpty(Model.UserName))
                                    {
                                        <div class="flex items-center space-x-2">
                                            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                                            </svg>
                                            <span>@Model.UserName</span>
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="flex flex-wrap gap-3 mt-4">
                                    @await Html.PartialAsync("_ChatButton", Model.Id)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <!-- Left Column -->
                        <div class="lg:col-span-2 space-y-8">
                            <!-- About Section -->
                            <div class="bg-white rounded-lg shadow p-6">
                                <h2 class="text-xl font-semibold text-gray-900 mb-4">About</h2>
                                @if (!string.IsNullOrEmpty(Model.Bio))
                                {
                                    <p class="text-gray-600 mb-4">@Model.Bio</p>
                                }
                                else
                                {
                                    <p class="text-gray-600 mb-4">
                                        <span class="text-gray-400 italic">No bio available</span>
                                    </p>
                                }
                            </div>

                            <!-- Skills Section -->
                            @if (Model.UserAccountSkills != null && Model.UserAccountSkills.Any())
                            {
                                <div class="bg-white rounded-lg shadow p-6">
                                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Skills</h2>
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var skill in Model.UserAccountSkills)
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                                                @skill.UserSkill.Name
                                            </span>
                                        }
                                    </div>
                                </div>
                            }

                            <div class="bg-white rounded-lg shadow p-6">
                                <h2 class="text-xl font-semibold text-gray-900 mb-4">Portfolio</h2>

                                @if (Model.Portfolios != null && Model.Portfolios.Any())
                                {
                                    <div class="space-y-4">
                                        @foreach (var portfolioItem in Model.Portfolios.OrderByDescending(p => p.CreatedAt))
                                        {
                                            <div class="p-4">
                                                <h3 class="font-medium text-gray-900 text-lg italic">@portfolioItem.Title</h3>
                                                @if (!string.IsNullOrWhiteSpace(portfolioItem.Description))
                                                {
                                                    <p class="text-sm text-gray-600 mt-4 mb-3 whitespace-pre-line break-words leading-relaxed mt-auto">
                                                        @portfolioItem.Description
                                                    </p>
                                                }
                                                <!-- Portfolio Files -->
                                                @if (!string.IsNullOrEmpty(portfolioItem.ProjectImages))
                                                {
                                                    try
                                                    {
                                                        var filePaths = System.Text.Json.JsonSerializer.Deserialize<List<string>>(portfolioItem.ProjectImages);
                                                        if (filePaths != null && filePaths.Any())
                                                        {
                                                            // Separate images and files
                                                            var imageFiles = new List<string>();
                                                            var documentFiles = new List<string>();

                                                            foreach (var filePath in filePaths)
                                                            {
                                                                var fileExtension = System.IO.Path.GetExtension(filePath)?.ToLower();
                                                                var isImage = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp" }.Contains(fileExtension);

                                                                if (isImage)
                                                                {
                                                                    imageFiles.Add(filePath);
                                                                }
                                                                else
                                                                {
                                                                    documentFiles.Add(filePath);
                                                                }
                                                            }

                                                            <!-- Display Images Section -->
                                                            @if (imageFiles.Any())
                                                            {
                                                                <div class="mb-3">
                                                                    <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                                                                        @foreach (var filePath in imageFiles)
                                                                        {
                                                                            var fileName = System.IO.Path.GetFileName(filePath);
                                                                            <div>
                                                                                <!-- Image Files -->
                                                                                <img src="@filePath"
                                                                                     alt="@fileName"
                                                                                     class="w-full h-full object-cover cursor-pointer hover:opacity-90 transition-opacity"
                                                                                     onclick="openImageModal('@filePath', '@fileName')"
                                                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='block';" />
                                                                                <!-- Fallback for failed image loads -->
                                                                                <div class="w-full h-full bg-gray-100 flex flex-col items-center justify-center cursor-pointer hover:bg-gray-200 transition-colors"
                                                                                     style="display: none;"
                                                                                     onclick="openImageModal('@filePath', '@fileName')">
                                                                                    <svg class="w-8 h-8 text-gray-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                                                    </svg>
                                                                                    <span class="text-xs text-gray-500 text-center px-1 truncate w-full">@fileName</span>
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }

                                                            <!-- Display Documents Section -->
                                                            @if (documentFiles.Any())
                                                            {
                                                                <div class="mb-3">
                                                                    <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                                                                        @foreach (var filePath in documentFiles)
                                                                        {
                                                                            var fileName = System.IO.Path.GetFileName(filePath);
                                                                            var fileExtension = System.IO.Path.GetExtension(filePath)?.ToLower();

                                                                            <div class="flex items-center space-x-2 p-2 bg-gray-50 rounded border border-gray-300">
                                                                                <div class="w-8 h-8 bg-blue-100 rounded flex items-center justify-center">
                                                                                    <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                                                                    </svg>
                                                                                </div>
                                                                                <a href="@filePath" target="_blank" class="text-sm text-blue-600 hover:text-blue-800 truncate max-w-32" title="@fileName">
                                                                                    @fileName
                                                                                </a>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                    }
                                                    catch
                                                    {
                                                        <!-- Handle JSON parsing errors gracefully -->
                                                    }
                                                }
                                                @if (!string.IsNullOrEmpty(portfolioItem.ProjectLink))
                                                {
                                                    <div class="flex items-center space-x-2 p-2 bg-blue-50 rounded border border-gray-300">
                                                        <div class="w-6 h-6 bg-blue-100 rounded flex items-center justify-center">
                                                            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                                            </svg>
                                                        </div>
                                                        <a href="@portfolioItem.ProjectLink" target="_blank" class="text-sm text-blue-600 hover:text-blue-800 truncate max-w-48" title="@portfolioItem.ProjectLink">
                                                            @portfolioItem.ProjectLink
                                                        </a>
                                                    </div>
                                                }
                                                <span class="flex items-center text-sm text-gray-500 mt-2">
                                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                    </svg>
                                                    @{
                                                        var phTime = TimeHelpers.ToPhilippineTime(portfolioItem.CreatedAt);
                                                    }
                                                    Added: @phTime.ToString("MMM dd, yyyy")
                                                </span>
                                            </div>
                                            <hr class="border-gray-300 mb-4">
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-gray-600">
                                        <span class="text-gray-400 italic">No portfolio available</span>
                                    </p>
                                }
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <h2 class="text-xl font-semibold text-gray-900 mb-4">Recent Reviews</h2>
                                @if (ViewBag.RecentFeedbacks.Count > 0)
                                {
                                    <div class="space-y-4">
                                        @foreach (var feedback in ViewBag.RecentFeedbacks)
                                        {
                                            <div class="flex justify-between items-start">
                                                <div>
                                                    <div class="flex items-center space-x-3 bg-gray-50 w-fit mb-3">
                                                        @if (!string.IsNullOrEmpty(feedback.AcceptBidding.Project.User.Photo))
                                                        {
                                                            <div class="rounded-full cursor-pointer hover:bg-gray-100 transition-colors duration-200" onclick="openProfileModal('@feedback.AcceptBidding.Project.User.Id')">
                                                                <img src="@feedback.AcceptBidding.Project.User.Photo" alt="Project Owner" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200">
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="rounded-full cursor-pointer hover:bg-gray-100 transition-colors duration-200" onclick="openProfileModal('@feedback.AcceptBidding.Project.User.Id')">
                                                                <img src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497" alt="Project Owner" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200">
                                                            </div>
                                                        }
                                                        <div class="flex flex-col">
                                                            <span class="font-semibold text-md text-gray-900">@(feedback.AcceptBidding.Project.User.FirstName) @(feedback.AcceptBidding.Project.User.LastName)</span>
                                                            <div class="flex">
                                                                @for (int i = 1; i <= 5; i++)
                                                                {
                                                                    if (i <= feedback.Rating)
                                                                    {
                                                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                                                                            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                                                            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                                                                            <g id="SVGRepo_iconCarrier"><path d="m12 17.328-5.403 3.286a.75.75 0 0 1-1.12-.813l1.456-6.155-4.796-4.123a.75.75 0 0 1 .428-1.316l6.303-.517 2.44-5.835a.75.75 0 0 1 1.384 0l2.44 5.835 6.303.517a.75.75 0 0 1 .427 1.316l-4.795 4.123 1.456 6.155a.75.75 0 0 1-1.12.813L12 17.328z" fill="#FFC203"></path></g>
                                                                        </svg>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-gray-300">⭐</span>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(feedback.Comments))
                                                    {
                                                        <p class="text-gray-700 mt-2">@feedback.Comments</p>
                                                    }
                                                </div>
                                                <div class="text-right">
                                                    @if (feedback.WouldRecommend)
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 text-center">
                                                            Would Recommend
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800 text-center">
                                                            Would Not Recommend
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <hr class="border-gray-300 mb-4">
                                        }
                                    </div>
                                }
                            </div>
                            <div class="bg-white rounded-lg shadow p-6">
                                <h2 class="text-xl font-semibold text-gray-900 mb-4">Mentorship Reviews</h2>
                                @if (ViewBag.MFeedback != null && ((IEnumerable<object>)ViewBag.MFeedback).Any())
                                {
                                    <div class="space-y-4">
                                        @foreach (var feedback in ViewBag.MFeedback)
                                        {
                                            var mentee = feedback.MentorshipMatch?.Mentee;
                                            <div class="flex justify-between items-start">
                                                <div>
                                                    <div class="flex items-center space-x-3 bg-gray-50 w-fit mb-3">
                                                        @if (!string.IsNullOrEmpty(mentee?.Photo))
                                                        {
                                                            <div class="rounded-full cursor-pointer hover:bg-gray-100 transition-colors duration-200" onclick="openProfileModal('@mentee.Id')">
                                                                <img src="@mentee.Photo" alt="Project Owner" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200">
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="rounded-full cursor-pointer hover:bg-gray-100 transition-colors duration-200" onclick="openProfileModal('@mentee.Id')">
                                                                <img src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497" alt="Project Owner" class="w-10 h-10 rounded-full object-cover border-2 border-gray-200">
                                                            </div>
                                                        }
                                                        <div class="flex flex-col">
                                                            <span class="font-semibold text-md text-gray-900">@($"{mentee?.FirstName} {mentee?.LastName}")</span>
                                                            <div class="flex">
                                                                @for (int i = 1; i <= 5; i++)
                                                                {
                                                                    if (i <= feedback?.Rating)
                                                                    {
                                                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5">
                                                                            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                                                            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                                                                            <g id="SVGRepo_iconCarrier"><path d="m12 17.328-5.403 3.286a.75.75 0 0 1-1.12-.813l1.456-6.155-4.796-4.123a.75.75 0 0 1 .428-1.316l6.303-.517 2.44-5.835a.75.75 0 0 1 1.384 0l2.44 5.835 6.303.517a.75.75 0 0 1 .427 1.316l-4.795 4.123 1.456 6.155a.75.75 0 0 1-1.12.813L12 17.328z" fill="#FFC203"></path></g>
                                                                        </svg>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="text-gray-300">⭐</span>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(feedback?.Comments))
                                                    {
                                                        <p class="text-gray-700 mt-2">@feedback.Comments</p>
                                                    }
                                                </div>
                                                <div class="text-right">
                                                    @if (feedback?.WouldRecommend == true)
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                            Would Recommend
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                            Would Not Recommend
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <hr class="border-gray-300 mb-4">
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-gray-600">
                                        <span class="text-gray-400 italic">No mentorship reviews yet</span>
                                    </p>
                                }
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="space-y-6">
                            <!-- Stats Card -->
                            <div class="bg-white rounded-lg shadow p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Statistics</h3>
                                <div class="space-y-4">
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Completed Work</span>
                                        <span class="font-semibold text-gray-900">@biddings.Count</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Total Reviews</span>
                                        <span class="font-semibold text-gray-900">@ViewBag.FeedbackCount</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Average Review</span>
                                        <span class="font-semibold text-gray-900">
                                            @if (ViewBag.AverageRating > 0)
                                            {
                                                <span>@ViewBag.AverageRating.ToString("F1")</span>
                                            }
                                            else
                                            {
                                                <span>No ratings yet</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-gray-600">Recommendation Rate</span>
                                        <span class="font-semibold text-gray-900">
                                            @if (ViewBag.RecommendationRate > 0)
                                            {
                                                <span>@ViewBag.RecommendationRate.ToString("F0")%</span>
                                            }
                                            else
                                            {
                                                <span>No feedback yet</span>
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Mentorship Status -->
                            @if (hasCompletedAsMentor || hasCompletedAsMentee)
                            {
                                <div class="bg-white rounded-lg shadow p-6">
                                    <h3 class="text-lg font-semibold text-gray-900 mb-4">Achievements</h3>
                                    <div class="space-y-3">
                                        @if (hasCompletedAsMentor)
                                        {
                                            <div class="flex items-center space-x-3 p-3 bg-blue-50 rounded-lg">
                                                <img class="w-8 h-8" src="https://ik.imagekit.io/6txj3mofs/mentor(1).png" alt="Mentor Badge" />
                                                <div>
                                                    <p class="font-medium text-blue-900">Mentor Badge</p>
                                                    <p class="text-sm text-blue-700">Successfully guided mentees</p>
                                                </div>
                                            </div>
                                        }
                                        @if (hasCompletedAsMentee)
                                        {
                                            <div class="flex items-center space-x-3 p-3 bg-green-50 rounded-lg">
                                                <img class="w-8 h-8" src="https://ik.imagekit.io/6txj3mofs/mentee.png" alt="Mentee Badge" />
                                                <div>
                                                    <p class="font-medium text-green-900">Mentee Badge</p>
                                                    <p class="text-sm text-green-700">Completed mentorship program</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Contact Information -->
                            <div class="bg-white rounded-lg shadow p-6">
                                <h3 class="text-lg font-semibold text-gray-900 mb-4">Contact Information</h3>
                                <div class="space-y-3">
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <div class="flex items-center space-x-3">
                                            <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                            </svg>
                                            <span class="text-gray-600">@Model.Email</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Modal - Updated with your preferred style -->
<div id="imageModal" class="fixed inset-0 flex items-center justify-center z-50 hidden" style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);" onclick="closeImageModal(event)">
    <div class="bg-white rounded-lg shadow-xl max-w-xl w-full max-h-full" onclick="event.stopPropagation()">
        <div class="relative p-8">
            <button type="button" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 rounded-full p-2 hover:bg-gray-100 transition-colors duration-200" onclick="closeImageModal()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
            <div class="text-center">
                <img id="modalImage" src="" alt="Project Image" class="max-w-full max-h-[80vh] object-contain mx-auto">
            </div>
        </div>
    </div>
</div>

<div id="profileModal" class="fixed inset-0 flex items-center justify-center z-50 hidden" style="background-color: rgba(0, 0, 0, 0.5); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);" onclick="closeProfileModal(event)">
    <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-full mx-4" onclick="event.stopPropagation()">
        <div class="relative p-6">
            <button type="button" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 rounded-full p-2 hover:bg-gray-100 transition-colors duration-200" onclick="closeProfileModal()">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
            <div class="flex flex-col md:flex-row items-start space-y-4 md:space-y-0 md:space-x-6">
                <!-- Profile Picture -->
                <div class="flex-shrink-0">
                    <img id="modalProfilePhoto" src="" alt="Profile Picture" class="w-32 h-32 rounded-full object-cover border-4 border-gray-200 shadow-lg">
                </div>

                <!-- Profile Information -->
                <div class="flex-1 min-w-0">
                    <h3 id="modalUserName" class="text-2xl font-bold text-gray-900 mb-2"></h3>

                    <div id="modalEmail" class="flex items-center mb-2" style="display: none;">
                        <svg class="w-5 h-5 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                        <span id="modalEmailText" class="text-gray-700"></span>
                    </div>

                    <div id="modalUsername" class="flex items-center mb-2" style="display: none;">
                        <svg class="w-5 h-5 text-gray-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                        </svg>
                        <span id="modalUsernameText" class="text-gray-700"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex inline-flex items-start justify-center space-x-3">
                        <div class="mt-6">
                            <div id="modalChatButton"></div>
                        </div>
                        <a id="modalProfileLink" href="#"
                           class="mt-6 inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors duration-200"
                           title="View Profile">
                            <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                <path fill-rule="evenodd" d="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4h-4Z" clip-rule="evenodd" />
                            </svg>
                            View Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openImageModal(imagePath, imageTitle = 'Project Image') {
        const modalImage = document.getElementById('modalImage');
        const modal = document.getElementById('imageModal');

        // Debug: Log the image path to console
        console.log('Opening image:', imagePath);

        // Set image source
        modalImage.src = imagePath;
        modalImage.alt = imageTitle;

        // Add image load error handling
        modalImage.onerror = function() {
            console.error('Failed to load image:', imagePath);
        };

        modalImage.onload = function() {
            console.log('Image loaded successfully:', imagePath);
        };

        // Show modal immediately without animation
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeImageModal(event) {
        // Check if event is provided and if the click target is the modal itself
        if (event && event.target !== event.currentTarget) {
            return;
        }

        const modal = document.getElementById('imageModal');

        // Hide modal immediately without animation
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';

        // Reset image src to free memory
        document.getElementById('modalImage').src = '';
    }

    function openProfileModal(userId) {
        // Check if user is clicking on their own profile
        const currentUserId = '@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value';
        if (currentUserId === userId) {
            return; // Don't open modal for own profile
        }

        // Use the DTOs instead of the full feedback objects
        const feedbackDtos = @Html.Raw(Json.Serialize(ViewBag.FeedbackDtos));
        const feedback = feedbackDtos.find(f => f.user.id === userId);

        if (!feedback) return;

        const user = feedback.user;
        const modal = document.getElementById('profileModal');

        // Set profile photo
        const profilePhoto = document.getElementById('modalProfilePhoto');
        profilePhoto.src = user.photo || 'https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497';

        // Set user name
        document.getElementById('modalUserName').textContent = `${user.firstName} ${user.lastName}`;

        // Set email if available
        const emailDiv = document.getElementById('modalEmail');
        const emailText = document.getElementById('modalEmailText');
        if (user.email && user.email.trim() !== '') {
            emailText.textContent = user.email;
            emailDiv.style.display = 'flex';
        } else {
            emailDiv.style.display = 'none';
        }

        // Set username if available
        const usernameDiv = document.getElementById('modalUsername');
        const usernameText = document.getElementById('modalUsernameText');
        if (user.userName && user.userName.trim() !== '') {
            usernameText.textContent = user.userName;
            usernameDiv.style.display = 'flex';
        } else {
            usernameDiv.style.display = 'none';
        }

        // Set profile link
        document.getElementById('modalProfileLink').href = `/Profile/Client/${userId}`;

        // Create chat button
        const chatButtonDiv = document.getElementById('modalChatButton');
        chatButtonDiv.innerHTML = `<a href="/Chat/Index?userId=${userId}" class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors duration-200">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z" clip-rule="evenodd"></path>
            </svg>
            Chat
        </a>`;

        // Show modal
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closeProfileModal(event) {
        // Check if event is provided and if the click target is the modal itself
        if (event && event.target !== event.currentTarget) {
            return;
        }

        const modal = document.getElementById('profileModal');
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    // Close profile modal when clicking outside the modal
    document.getElementById('profileModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeProfileModal();
        }
    });


    // Close modal with Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const imageModal = document.getElementById('imageModal');
            const profileModal = document.getElementById('profileModal');

            if (!imageModal.classList.contains('hidden')) {
                closeImageModal();
            }
            if (!profileModal.classList.contains('hidden')) {
                closeProfileModal();
            }
        }
    });

    // Prevent modal from closing when clicking on the image itself
    document.getElementById('modalImage').addEventListener('click', function(e) {
        e.stopPropagation();
    });
</script>