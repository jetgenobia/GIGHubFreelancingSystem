@{
	Layout = "_LayoutFreelancer";
	ViewData["Title"] = "Dashboard";
}

@model Freelancing.Models.Entities.PeerMentorship

<div class="p-4 sm:ml-64">
	<div class="p-4 mt-20">
		<div class="mt-20" style="margin-top: 100px">
			<div class="text-center block w-full p-6">
				<h6 class="mb-4 text-5xl font-bold text-gray-900">GIGBuddies</h6>
				<h5 class="text-xl font-light text-gray-900 tracking-tight text-balance sm:text-lg">an integrated mentorship platform that connects aspiring freelancers with experienced mentors. Whether you're just starting out or looking to level up your career, our community-driven system offers personalized guidance, skills development, and real-world opportunities—all in one place. Join us and thrive in the gig economy through peer support and professional growth.</h5>
			</div>
			<div class="text-center block w-full p-6">
				@if (Model.Role == "Mentee")
				{
					<a asp-controller="MentorshipMatching" asp-action="MenteeDashboard" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">Go to Dashboard</a>
				}
				else
				{
					<a asp-controller="MentorshipMatching" asp-action="MentorDashboard" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800">Go to Dashboard</a>
				}
			</div>
		</div>

		<!-- About GIGBuddies -->
		<div class="bg-white rounded-lg shadow-sm border p-6">
			<h2 class="text-xl font-semibold text-gray-900 mb-4">About GIGBuddies</h2>
			<p class="text-gray-700 text-balance leading-relaxed">
				GIGBuddies is an integrated mentorship platform that connects aspiring freelancers with experienced mentors. 
				Whether you're just starting out or looking to level up your career, our community-driven system offers 
				personalized guidance, skills development, and real-world opportunities—all in one place. Join us and thrive 
				in the gig economy through peer support and professional growth.
			</p>
		</div>

		@if (User.FindFirst("MentorshipId")?.Value.Equals(Model.Id.ToString()) == true)
		{
			<div class="bg-green-50 border border-green-200 rounded-lg p-4 mt-6">
				<div class="flex">
					<div class="flex-shrink-0">
						<svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="ml-3">
						<h3 class="text-sm font-medium text-green-800">Ready to Go!</h3>
						<div class="mt-2 text-sm text-green-700">
							<p>Your GIGBuddies account is fully activated. You can now access all mentorship features.</p>
						</div>
					</div>
				</div>
			</div>
		}
		else
		{
			<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mt-6">
				<div class="flex">
					<div class="flex-shrink-0">
						<svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
						</svg>
					</div>
					<div class="ml-3">
						<h3 class="text-sm font-medium text-yellow-800">Session Update Needed</h3>
						<div class="mt-2 text-sm text-yellow-700">
							<p>Your session needs to be updated to access all features. Click the button below to refresh your session.</p>
							<button id="refreshClaimsBtn" class="mt-2 inline-flex items-center px-3 py-1.5 border border-transparent text-xs font-medium rounded text-yellow-800 bg-yellow-100 hover:bg-yellow-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500">
								<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
								</svg>
								Refresh Session
							</button>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>

<script>
document.getElementById('refreshClaimsBtn')?.addEventListener('click', async function() {
    try {
        const response = await fetch('/PeerMentorship/RefreshClaims', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        });
        
        const result = await response.json();
        
        if (result.success) {
            // Reload the page to show updated claims
            location.reload();
        } else {
            alert('Failed to refresh session: ' + result.message);
        }
    } catch (error) {
        console.error('Error refreshing claims:', error);
        alert('An error occurred while refreshing your session. Please try again.');
    }
});
</script>