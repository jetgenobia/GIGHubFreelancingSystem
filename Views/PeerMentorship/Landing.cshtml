                            </g>
                        </svg>
                        <span class="sr-only">Messages</span>
                        <div id="message-counter" class="absolute inline-flex items-center justify-center w-5 h-5 text-xs font-bold text-white bg-red-500 border-2 border-white rounded-full -top-1 -end-1" style="display: none;">0</div>
                    </a>

                    <!-- Dropdown menu -->
                    <div id="dropdownNotification" class="z-20 hidden w-full max-w-sm bg-white divide-y divide-gray-100 rounded-lg shadow-lg" aria-labelledby="dropdownNotificationButton">
                        <div class="block px-4 py-2 font-medium text-center text-gray-700 rounded-t-lg bg-gray-50">
                            Notifications
                        </div>
                        <div class="divide-y divide-gray-100 max-h-64 overflow-y-auto">
                            <!-- Notifications will be loaded dynamically here -->
                        </div>
                        <!-- View All button will be added dynamically by JavaScript -->
                    </div>
                    <div class="flex items-center me-5">
                        <div>
                            <button type="button" class="flex text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300" aria-expanded="false" data-dropdown-toggle="dropdown-user">
                                <span class="sr-only">Open user menu</span>
                                @if (!string.IsNullOrEmpty(@User.FindFirst("Photo")?.Value))
                                {
                                    <img class="w-8 h-8 rounded-full" src="@User.FindFirst("Photo")?.Value" alt="user photo">
                                }
                                else
                                {
                                    <img class="w-8 h-8 rounded-full" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497" alt="user photo">
                                }
                            </button>
                        </div>
                        <div class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded-sm shadow-sm" id="dropdown-user">
                            <div class="px-4 py-3" role="none">
                                <p class="text-sm text-gray-900" role="none">
                                    @User.FindFirst("FullName")?.Value
                                </p>
                                <p class="text-sm font-medium text-gray-900 truncate" role="none">
                                    @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                                </p>
                            </div>
                            <ul class="py-1" role="none">
                                <li>
                                    <a asp-controller="Account" asp-action="LogOut" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" role="menuitem">Sign out</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <div class="pt-24 p-4 grid grid-cols-1 lg:grid-cols-2 items-center bg-gray-50 min-h-screen gap-8">
        <div class="p-4 mt-6 lg:mt-0 lg:pl-24 md:pl-12 pl-6">
            <div>
                <div class="block w-full text-center lg:text-start">
                    <h6 class="mb-4 text-4xl sm:text-5xl font-bold text-gray-900">GIGBuddies</h6>
                </div>
                <div class="block w-full mt-3 text-center lg:text-start">
                    <h5 class="text-base sm:text-lg md:text-xl font-light text-gray-900 tracking-tight text-balance">an integrated mentorship platform that connects aspiring freelancers with experienced mentors. Whether you're just starting out or looking to level up your career, our community-driven system offers personalized guidance, skills development, and real-world opportunities—all in one place. Join us and thrive in the gig economy through peer support and professional growth.</h5>
                    <h5 class="text-sm sm:text-lg font-light text-gray-500 tracking-tight text-balance mt-4">Get started now by choosing a role.</h5>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center items-center justify-start sm:justify-start w-full mt-6 gap-3">
                    @{
                        var hasSkills = ViewBag.HasSkills as bool? ?? false;
                        var isVerified = ViewBag.IsVerified as bool? ?? false;
                    }

                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (hasSkills && isVerified)
                        {
                            <!-- User has both skills and verified identity - show normal mentor/mentee buttons -->
                            <div class="flex items-center justify-center gap-5">
                                <div>
                                    <a asp-controller="PeerMentorship" asp-action="Registration" asp-route-role="Mentor" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 focus:outline-none">Mentor</a>
                                </div>
                                <div>
                                    <a asp-controller="PeerMentorship" asp-action="Registration" asp-route-role="Mentee" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 focus:outline-none">Mentee</a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- User doesn't meet requirements - show requirements checklist -->
                            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 w-full max-w-2xl">
                                <div class="flex items-start">
                                    <svg class="shrink-0 w-5 h-5 mr-3 mt-1 text-yellow-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                                    </svg>
                                    <div class="flex-1">
                                        <h3 class="text-lg font-semibold text-yellow-800 mb-3">Complete Your Profile Requirements</h3>
                                        <p class="text-sm text-yellow-700 mb-4">To join the GIGBuddies mentorship program, please complete the following requirements:</p>

                                        <div class="space-y-3">
                                            <!-- Skills Requirement -->
                                            <div class="flex items-center space-x-3">
                                                @if (hasSkills)
                                                {
                                                    <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                                    </svg>
                                                    <span class="text-sm text-green-700 font-medium">✓ Skills added to profile</span>
                                                }
                                                else
                                                {
                                                    <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                                    </svg>
                                                    <div class="flex items-center space-x-2">
                                                        <span class="text-sm text-gray-600">Add skills to your profile</span>
                                                        <a asp-controller="@(User.IsInRole("Freelancer") ? "Freelancer" : "Client")" asp-action="EditAccount"
                                                           class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded hover:bg-blue-200 transition-colors text-center">
                                                            Add Skills →
                                                        </a>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Identity Verification Requirement -->
                                            <div class="flex items-center space-x-3">
                                                @if (isVerified)
                                                {
                                                    <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                                                    </svg>
                                                    <div class="flex items-center space-x-2">
                                                        <span class="text-sm text-green-700 font-medium">✓ Identity verified</span>
                                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500">
