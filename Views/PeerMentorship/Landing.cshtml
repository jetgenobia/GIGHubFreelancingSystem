                                                            <path d="M16.3736 9.86298C16.6914 9.54515 16.6914 9.02984 16.3736 8.71201C16.0557 8.39417 15.5404 8.39417 15.2226 8.71201L10.3723 13.5623L8.77753 11.9674C8.4597 11.6496 7.94439 11.6496 7.62656 11.9674C7.30873 12.2853 7.30873 12.8006 7.62656 13.1184L9.79685 15.2887C10.1147 15.6065 10.63 15.6065 10.9478 15.2887L16.3736 9.86298Z" fill="#1C96E8"></path>
                                                        </svg>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <svg class="w-5 h-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                                    </svg>
                                                    <div class="flex items-center space-x-2">
                                                        <span class="text-sm text-gray-600">Verify your identity</span>
                                                        <a asp-controller="IdentityVerification" asp-action="Index"
                                                           class="text-xs bg-orange-100 text-orange-800 px-2 py-1 rounded hover:bg-orange-200 transition-colors text-center">
                                                            Verify Identity →
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        <div class="mt-4 pt-3 border-t border-yellow-200">
                                            <p class="text-xs text-yellow-600">
                                                <strong>Why do we need this?</strong> Identity verification ensures a safe and trustworthy mentorship community, while skills help us match you with the right mentor or mentee.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- User not authenticated - show login prompt -->
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 w-full max-w-md">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 text-blue-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                                </svg>
                                <div>
                                    <h3 class="text-sm font-medium text-blue-800">Join GIGBuddies</h3>
                                    <p class="text-sm text-blue-700 mt-1">Please log in to access the mentorship program.</p>
                                    <div class="mt-2">
                                        <a asp-controller="Account" asp-action="Login" class="text-sm bg-blue-100 text-blue-800 px-3 py-1 rounded hover:bg-blue-200 transition-colors">
                                            Login →
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="p-4 flex justify-center items-center">
            <div class="w-full max-w-lg flex justify-center items-center mt-6 lg:mt-0">
                <img class="w-full max-w-md lg:max-w-lg object-contain" src="https://ik.imagekit.io/6txj3mofs/PEERMENTOR.png?updatedAt=1754184399237" alt="">
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
    <script src="~/js/global-video-call.js" asp-append-version="true"></script>
    <script src="~/js/search.js" asp-append-version="true"></script>
    <script src="~/js/message-counter.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
</body>
</html>