@model Freelancing.Models.OngoingProjectListViewModel
@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Manage Projects";
}

<div class="p-4 sm:ml-64">
    <div class="pt-2 mt-20">
        <div class="mt-1">
            <div class="block w-full p-6">
                <h2 class="mb-4 text-2xl font-bold text-gray-900">Manage Projects</h2>

                @if (Model.OngoingProjects.Any())
                {
                    var activeProjects = Model.OngoingProjects.Where(p => p.ProjectStatus == "Active" || p.ProjectStatus == "Draft" || p.ProjectStatus == "AwaitingClient" || p.ProjectStatus == "AwaitingFreelancer").ToList();
                    var terminatedProjects = Model.OngoingProjects.Where(p => p.ProjectStatus == "Terminated").ToList();
                    var completedProjects = Model.OngoingProjects.Where(p => p.ProjectStatus == "Completed").ToList();

                    <!-- Summary Cards -->
                    <div class="mb-6 flex flex-wrap gap-2">
                        @if (activeProjects.Any())
                        {
                            <a href="#active-projects-section" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800 hover:bg-green-200 transition duration-200 cursor-pointer">
                                @activeProjects.Count Active Project@(activeProjects.Count != 1 ? "s" : "")
                            </a>
                        }
                        @if (terminatedProjects.Any())
                        {
                            <a href="#terminated-projects-section" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800 hover:bg-red-200 transition duration-200 cursor-pointer">
                                @terminatedProjects.Count Terminated Project@(terminatedProjects.Count != 1 ? "s" : "")
                            </a>
                        }
                        @if (completedProjects.Any())
                        {
                            <a href="#completed-projects-section" class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800 hover:bg-blue-200 transition duration-200 cursor-pointer">
                                @completedProjects.Count Completed Project@(completedProjects.Count != 1 ? "s" : "")
                            </a>
                        }
                    </div>

                    <!-- Active Projects Section -->
                    @if (activeProjects.Any())
                    {
                        <div id="active-projects-section" class="mb-8 scroll-mt-24">
                            <div class="flex items-center mb-4">
                                <h3 class="text-xl font-semibold text-gray-900">Active Projects</h3>
                            </div>
                            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                                @foreach (var project in activeProjects)
                                {
                                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 border-l-4 border-l-green-500">
                                        <div class="flex items-start justify-between mb-4">
                                            <h4 class="text-lg font-semibold text-gray-900">@project.ProjectName</h4>
                                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                @project.ProjectStatus
                                            </span>
                                        </div>

                                        <div class="space-y-3">
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Accepted Amount:</span>
                                                <span class="text-sm font-medium text-green-600">₱@project.AcceptedBidAmount</span>
                                            </div>

                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Category:</span>
                                                <span class="text-sm font-medium text-gray-900">@project.ProjectCategory</span>
                                            </div>

                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Delivery:</span>
                                                <span class="text-sm font-medium text-gray-900">@project.AcceptedBidDelivery</span>
                                            </div>
                                        </div>

                                        <div class="mt-4 pt-4 border-t border-gray-100">
                                            <div class="flex items-center space-x-2">
                                                <img src="@project.FreelancerPhoto" alt="@project.FreelancerName" class="w-8 h-8 rounded-full">
                                                <div>
                                                    <p class="text-sm font-medium text-gray-900">@project.FreelancerName</p>
                                                    <p class="text-xs text-gray-500">Freelancer</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-4 flex space-x-2">
                                            <a href="@Url.Action("Details", new { id = project.ProjectId })"
                                               class="flex-1 bg-blue-600 text-white text-center py-2 px-4 rounded-md text-sm font-medium hover:bg-blue-700 transition duration-200">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Completed Projects Section -->
                    @if (completedProjects.Any())
                    {
                        <div id="completed-projects-section" class="mb-8 scroll-mt-24">
                            <div class="flex items-center mb-4">
                                <h3 class="text-xl font-semibold text-gray-900">Completed Projects</h3>
                            </div>
                            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                                @foreach (var project in completedProjects)
                                {
                                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 border-l-4 border-l-blue-500">
                                        <div class="flex items-start justify-between mb-4">
                                            <h4 class="text-lg font-semibold text-gray-900">@project.ProjectName</h4>
                                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                @project.ProjectStatus
                                            </span>
                                        </div>

                                        <div class="space-y-3">
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Accepted Amount:</span>
                                                <span class="text-sm font-medium text-green-600">₱@project.AcceptedBidAmount</span>
                                            </div>

                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Category:</span>
                                                <span class="text-sm font-medium text-gray-900">@project.ProjectCategory</span>
                                            </div>

                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Delivery:</span>
                                                <span class="text-sm font-medium text-gray-900">@project.AcceptedBidDelivery</span>
                                            </div>
                                        </div>

                                        <div class="mt-4 pt-4 border-t border-gray-100">
                                            <div class="flex items-center space-x-2">
                                                <img src="@project.FreelancerPhoto" alt="@project.FreelancerName" class="w-8 h-8 rounded-full">
                                                <div>
                                                    <p class="text-sm font-medium text-gray-900">@project.FreelancerName</p>
                                                    <p class="text-xs text-gray-500">Freelancer</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-4 flex space-x-2">
                                            <a href="@Url.Action("Details", new { id = project.ProjectId })"
                                               class="flex-1 bg-blue-600 text-white text-center py-2 px-4 rounded-md text-sm font-medium hover:bg-blue-700 transition duration-200">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Terminated Projects Section -->
                    @if (terminatedProjects.Any())
                    {
                        <div id="terminated-projects-section" class="mb-8 scroll-mt-24">
                            <div class="flex items-center mb-4">
                                <h3 class="text-xl font-semibold text-gray-900">Terminated Projects</h3>
                            </div>
                            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                                @foreach (var project in terminatedProjects)
                                {
                                    <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 border-l-4 border-l-red-500 opacity-75">
                                        <div class="flex items-start justify-between mb-4">
                                            <h4 class="text-lg font-semibold text-gray-900">@project.ProjectName</h4>
                                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                                @project.ProjectStatus
                                            </span>
                                        </div>

                                        <div class="space-y-3">
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Accepted Amount:</span>
                                                <span class="text-sm font-medium text-green-600">₱@project.AcceptedBidAmount</span>
                                            </div>

                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Category:</span>
                                                <span class="text-sm font-medium text-gray-900">@project.ProjectCategory</span>
                                            </div>

                                            <div class="flex items-center justify-between">
                                                <span class="text-sm text-gray-500">Delivery:</span>
                                                <span class="text-sm font-medium text-gray-900">@project.AcceptedBidDelivery</span>
                                            </div>
                                        </div>

                                        <div class="mt-4 pt-4 border-t border-gray-100">
                                            <div class="flex items-center space-x-2">
                                                <img src="@project.FreelancerPhoto" alt="@project.FreelancerName" class="w-8 h-8 rounded-full">
                                                <div>
                                                    <p class="text-sm font-medium text-gray-900">@project.FreelancerName</p>
                                                    <p class="text-xs text-gray-500">Freelancer</p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-4 flex space-x-2">
                                            <a href="@Url.Action("Details", new { id = project.ProjectId })"
                                               class="flex-1 bg-gray-600 text-white text-center py-2 px-4 rounded-md text-sm font-medium hover:bg-gray-700 transition duration-200">
                                                View Details
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">No projects</h3>
                        <p class="mt-1 text-sm text-gray-500">You don't have any projects with accepted freelancers yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    html {
        scroll-behavior: smooth;
    }
</style>