@model SearchViewModel
@{
    Layout = User.IsInRole("Client") ? "_LayoutClient" : "_LayoutFreelancer";
    ViewData["Title"] = "Search Results";
    var userIsClient = User.IsInRole("Client");
    var userIsFreelancer = User.IsInRole("Freelancer");
}

<div class="p-4 sm:ml-64">
    <div class="p-4 mt-20">
        <div class="mt-4">
            @if (!string.IsNullOrEmpty(Model.SearchTerm))
            {
                <!-- Results Summary -->
                <div class="max-w-4xl mx-auto mb-6">
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">Search Results</h2>
                    <p class="text-gray-600">Found @Model.TotalResults results for "@Model.SearchTerm"</p>
                </div>

                @if (!Model.HasResults)
                {
                    <!-- No Results -->
                    <div class="max-w-4xl mx-auto">
                        <div class="text-center py-12">
                            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                            <h3 class="mt-2 text-sm font-medium text-gray-900">No results found</h3>
                            <p class="mt-1 text-sm text-gray-500">Try adjusting your search terms</p>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Users Results -->
                    @if (Model.Users.Any())
                    {
                        <div class="max-w-4xl mx-auto mb-6">
                            <div class="grid grid-cols-1 gap-6">
                                @foreach (var user in Model.Users)
                                {
                                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
                                        <div class="p-6">
                                            <div class="flex items-center space-x-4">
                                                <div class="flex-shrink-0">
                                                    @if (!string.IsNullOrEmpty(user.Photo))
                                                    {
                                                        <img class="h-12 w-12 rounded-full" src="@user.Photo" alt="@user.FirstName" />
                                                    }
                                                    else
                                                    {
                                                        <img class="h-12 w-12 rounded-full" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497" alt="@user.FirstName" />
                                                    }
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm font-medium text-gray-900 truncate">
                                                        @user.FirstName @user.LastName
                                                    </p>
                                                    <p class="text-sm text-gray-500 truncate">@user.UserName</p>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(user.Bio))
                                            {
                                                <p class="mt-3 text-sm text-gray-600 line-clamp-2">@user.Bio</p>
                                            }
                                            @if (user.UserAccountSkills.Any())
                                            {
                                                <div class="mt-3 flex flex-wrap gap-1">
                                                    @foreach (var skill in user.UserAccountSkills.Take(3))
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-800">
                                                            @skill.UserSkill.Name
                                                        </span>
                                                    }
                                                    @if (user.UserAccountSkills.Count > 3)
                                                    {
                                                        <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-800">
                                                            +@(user.UserAccountSkills.Count - 3) more
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            @if (user.FRole == "Freelancer")
                                            {
                                                <div class="mt-4">
                                                    <a href="@Url.Action("Freelancer", "Profile", new { id = user.Id })" 
                                                    class="text-sm font-medium text-blue-600 hover:text-blue-500">
                                                        View Profile →
                                                    </a>
                                                </div>
                                            }else if (user.FRole == "Client")
                                            {
                                                <div class="mt-4">
                                                    <a href="@Url.Action("Client", "Profile", new { id = user.Id })"
                                                       class="text-sm font-medium text-blue-600 hover:text-blue-500">
                                                        View Profile →
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Projects Results -->
                    @if (Model.Projects.Any())
                    {
                        <div class="max-w-4xl mx-auto">
                            <div class="grid grid-cols-1 gap-6">
                                @foreach (var project in Model.Projects)
                                {
                                    <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow">
                                        <div class="p-6">
                                            <div class="flex items-start justify-between">
                                                <div class="flex-1">
                                                    <h4 class="text-lg font-semibold text-gray-900 mb-2">@project.ProjectName</h4>
                                                    <p class="text-sm text-gray-600 mb-3 line-clamp-3">@project.ProjectDescription</p>
                                                    
                                                    <div class="flex items-center space-x-4 text-sm text-gray-500 mb-3">
                                                        <span>@project.Category</span>
                                                        <span>•</span>
                                                        <span>₱@project.Budget</span>
                                                    </div>
                                                    
                                                    @if (project.ProjectSkills.Any())
                                                    {
                                                        <div class="flex flex-wrap gap-1 mb-4">
                                                            @foreach (var skill in project.ProjectSkills.Take(3))
                                                            {
                                                                <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-green-100 text-green-800">
                                                                    @skill.UserSkill.Name
                                                                </span>
                                                            }
                                                            @if (project.ProjectSkills.Count > 3)
                                                            {
                                                                <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-green-100 text-green-800">
                                                                    +@(project.ProjectSkills.Count - 3) more
                                                                </span>
                                                            }
                                                        </div>
                                                    }
                                                    
                                                    <div class="flex items-center justify-between">
                                                        <div class="flex items-center space-x-2">
                                                            @if (!string.IsNullOrEmpty(project.User.Photo))
                                                            {
                                                                <img class="h-6 w-6 rounded-full" src="@project.User.Photo" alt="@project.User.FirstName" />
                                                            }
                                                            else
                                                            {
                                                                <div class="h-6 w-6 rounded-full bg-gray-300 flex items-center justify-center">
                                                                    <span class="text-gray-600 text-xs font-semibold">@project.User.FirstName[0]@project.User.LastName[0]</span>
                                                                </div>
                                                            }
                                                            <span class="text-sm text-gray-600">@project.User.FirstName @project.User.LastName</span>
                                                        </div>
                                                        <span class="text-xs text-gray-500">@project.CreatedAt.ToString("MMM dd, yyyy")</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mt-4">
                                                <a href="@Url.Action("Project", userIsClient ? "Client" : "Freelancer", new { id = project.Id })"
                                                   class="text-sm font-medium text-blue-600 hover:text-blue-500">
                                                    View Project →
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="max-w-4xl mx-auto">
                    <div class="text-center py-12">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">Search for users and projects</h3>
                        <p class="mt-1 text-sm text-gray-500">Use the search bar in the navigation to find what you're looking for.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>