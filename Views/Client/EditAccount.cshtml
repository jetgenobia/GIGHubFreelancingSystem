                                                <path d="M16.3736 9.86298C16.6914 9.54515 16.6914 9.02984 16.3736 8.71201C16.0557 8.39417 15.5404 8.39417 15.2226 8.71201L10.3723 13.5623L8.77753 11.9674C8.4597 11.6496 7.94439 11.6496 7.62656 11.9674C7.30873 12.2853 7.30873 12.8006 7.62656 13.1184L9.79685 15.2887C10.1147 15.6065 10.63 15.6065 10.9478 15.2887L16.3736 9.86298Z" fill="#1C96E8"></path>
                                            </g>
                                        </svg>
                                    </span>
                                </div>
                            </div>

                            <div class="col-span-2 sm:col-span-1">
                                <label asp-for="LastName" class="block mb-2 text-sm font-medium text-gray-900">Last Name</label>
                                <div class="relative">
                                    <input asp-for="LastName" class="form-control bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" required disabled>
                                    <input type="hidden" asp-for="LastName" />
                                    <span class="absolute inset-y-0 end-0 flex items-center mr-3 pointer-events-none">
                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500">
                                            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                                            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                                            <g id="SVGRepo_iconCarrier">
                                                <path opacity="0.5" d="M9.59236 3.20031C9.34886 3.40782 9.2271 3.51158 9.09706 3.59874C8.79896 3.79854 8.46417 3.93721 8.1121 4.00672C7.95851 4.03705 7.79903 4.04977 7.48008 4.07522L7.48007 4.07523C6.67869 4.13918 6.278 4.17115 5.94371 4.28923C5.17051 4.56233 4.56233 5.17051 4.28923 5.94371C4.17115 6.278 4.13918 6.67869 4.07523 7.48007L4.07522 7.48008C4.04977 7.79903 4.03705 7.95851 4.00672 8.1121C3.93721 8.46417 3.79854 8.79896 3.59874 9.09706C3.51158 9.2271 3.40781 9.34887 3.20028 9.59239L3.20027 9.5924C2.67883 10.2043 2.4181 10.5102 2.26522 10.8301C1.91159 11.57 1.91159 12.43 2.26522 13.1699C2.41811 13.4898 2.67883 13.7957 3.20027 14.4076L3.20031 14.4076C3.4078 14.6511 3.51159 14.7729 3.59874 14.9029C3.79854 15.201 3.93721 15.5358 4.00672 15.8879C4.03705 16.0415 4.04977 16.201 4.07522 16.5199L4.07523 16.5199C4.13918 17.3213 4.17115 17.722 4.28923 18.0563C4.56233 18.8295 5.17051 19.4377 5.94371 19.7108C6.27799 19.8288 6.67867 19.8608 7.48 19.9248L7.48008 19.9248C7.79903 19.9502 7.95851 19.963 8.1121 19.9933C8.46417 20.0628 8.79896 20.2015 9.09706 20.4013C9.22711 20.4884 9.34887 20.5922 9.5924 20.7997C10.2043 21.3212 10.5102 21.5819 10.8301 21.7348C11.57 22.0884 12.43 22.0884 13.1699 21.7348C13.4898 21.5819 13.7957 21.3212 14.4076 20.7997C14.6511 20.5922 14.7729 20.4884 14.9029 20.4013C15.201 20.2015 15.5358 20.0628 15.8879 19.9933C16.0415 19.963 16.201 19.9502 16.5199 19.9248L16.52 19.9248C17.3213 19.8608 17.722 19.8288 18.0563 19.7108C18.8295 19.4377 19.4377 18.8295 19.7108 18.0563C19.8288 17.722 19.8608 17.3213 19.9248 16.52L19.9248 16.5199C19.9502 16.201 19.963 16.0415 19.9933 15.8879C20.0628 15.5358 20.2015 15.201 20.4013 14.9029C20.4884 14.7729 20.5922 14.6511 20.7997 14.4076C21.3212 13.7957 21.5819 13.4898 21.7348 13.1699C22.0884 12.43 22.0884 11.57 21.7348 10.8301C21.5819 10.5102 21.3212 10.2043 20.7997 9.5924C20.5922 9.34887 20.4884 9.22711 20.4013 9.09706C20.2015 8.79896 20.0628 8.46417 19.9933 8.1121C19.963 7.95851 19.9502 7.79903 19.9248 7.48008L19.9248 7.48C19.8608 6.67867 19.8288 6.27799 19.7108 5.94371C19.4377 5.17051 18.8295 4.56233 18.0563 4.28923C17.722 4.17115 17.3213 4.13918 16.5199 4.07523L16.5199 4.07522C16.201 4.04977 16.0415 4.03705 15.8879 4.00672C15.5358 3.93721 15.201 3.79854 14.9029 3.59874C14.7729 3.51158 14.6511 3.40781 14.4076 3.20027C13.7957 2.67883 13.4898 2.41811 13.1699 2.26522C12.43 1.91159 11.57 1.91159 10.8301 2.26522C10.5102 2.4181 10.2043 2.67883 9.5924 3.20027L9.59236 3.20031Z" fill="#1C96E8"></path>
                                                <path d="M16.3736 9.86298C16.6914 9.54515 16.6914 9.02984 16.3736 8.71201C16.0557 8.39417 15.5404 8.39417 15.2226 8.71201L10.3723 13.5623L8.77753 11.9674C8.4597 11.6496 7.94439 11.6496 7.62656 11.9674C7.30873 12.2853 7.30873 12.8006 7.62656 13.1184L9.79685 15.2887C10.1147 15.6065 10.63 15.6065 10.9478 15.2887L16.3736 9.86298Z" fill="#1C96E8"></path>
                                            </g>
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-span-2 sm:col-span-1">
                                <label asp-for="FirstName" class="block mb-2 text-sm font-medium text-gray-900">First Name</label>
                                <input asp-for="FirstName" class="form-control border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" required>
                            </div>

                            <div class="col-span-2 sm:col-span-1">
                                <label asp-for="LastName" class="block mb-2 text-sm font-medium text-gray-900">Last Name</label>
                                <input asp-for="LastName" class="form-control border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" required>
                            </div>
                        }

                        <div class="col-span-2 sm:col-span-1">
                            <label asp-for="Email" id="email-address" class="control-label block mb-2 text-sm font-medium text-gray-900">Email</label>
                            <div class="relative">
                                <input asp-for="Email" id="email-address-icon" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" required>
                                <button type="button" class="absolute inset-y-0 end-0 flex items-center px-3 rounded-r-lg bg-blue-700 hover:bg-blue-800 text-white text-sm" id="changeEmailBtn">
                                    Change
                                </button>
                            </div>
                            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                        </div>

                        <div class="col-span-2 sm:col-span-1">
                            <label asp-for="UserName" class="block mb-2 text-sm font-medium text-gray-900">Username</label>
                            <input asp-for="UserName" class="form-control border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" required>
                        </div>
                        <div class="col-span-2">
                            <label asp-for="Bio" class="block mb-2 text-sm font-medium text-gray-900">Bio</label>
                            <textarea asp-for="Bio" rows="4" class="form-control block p-2.5 w-full text-sm text-gray-900 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500" placeholder="Write your bio here"></textarea>
                        </div>

                        @if ((ViewBag.TwoFactorEnabled as bool?) ?? false)
                        {
                            <div class="mb-4">
                                <label class="block text-sm font-medium text-gray-900">Two-Factor Authentication</label>
                                <p class="text-xs italic">Your account is currently protected by two-factor authentication.</p>
                                <p class="text-xs italic mb-2">If you wish to generate a new backup code/reset authentication please click the button below.</p>
                                <div class="mb-6 flex gap-4">
                                    <a href="@Url.Action("ResetAuthenticator", "Account")"
                                       class="inline-flex items-center text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2">
                                        <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.5 11.5 11 13l4-3.5M12 20a16.405 16.405 0 0 1-5.092-5.804A16.694 16.694 0 0 1 5 6.666L12 4l7 2.667a16.695 16.695 0 0 1-1.908 7.529A16.406 16.406 0 0 1 12 20Z" />
                                        </svg>
                                        Reset
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                <label class="block mb-2 text-sm font-medium text-gray-900">Two-Factor Authentication</label>
                                <div class="mb-6 flex gap-4">
                                    <a href="@Url.Action("EnableAuthenticator", "Account")"
                                       class="inline-flex items-center text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2">
                                        <svg class="w-4 h-4 mr-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 20a16.405 16.405 0 0 1-5.092-5.804A16.694 16.694 0 0 1 5 6.666L12 4l7 2.667a16.695 16.695 0 0 1-1.908 7.529A16.406 16.406 0 0 1 12 20Z" />
                                        </svg>
                                        Enable
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="flex justify-end space-x-2">
                        <button type="submit"
                                class="mt-5 text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                            Save Changes
                        </button>
                        <button type="button"
                                data-modal-target="deleteAccountModal"
                                data-modal-toggle="deleteAccountModal"
                                class="mt-5 text-white inline-flex items-center bg-red-700 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                            Delete Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="deleteAccountModal" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full backdrop-blur-sm bg-opacity-50">
    <div class="relative p-4 w-full max-w-md max-h-full">
        <div class="relative bg-white rounded-lg shadow-lg">
            <button type="button" class="absolute top-3 end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="deleteAccountModal">
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"></path>
                </svg>
                <span class="sr-only">Close modal</span>
            </button>

            <div class="p-6 text-center">
                <svg class="mx-auto mb-4 text-red-500 w-12 h-12" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
                </svg>
                <h3 class="mb-3 text-lg font-semibold text-gray-900">Delete Your Account</h3>
                <p class="mb-4 text-sm text-gray-500">Are you sure you want to delete your account? This action will:</p>
                <ul class="mb-4 text-sm text-gray-500 text-left">
                    <li class="mb-1">• Remove your profile and personal information</li>
                    <li class="mb-1">• Cancel any open project postings</li>
                    <li class="mb-1">• Make your account recoverable for 30 days</li>
                    <li class="mb-1">• Allow recovery by logging in within 30 days</li>
                </ul>
                <p class="mb-5 text-sm font-medium text-red-600">You cannot delete your account if you have active or ongoing projects.</p>

                <form asp-action="DeleteAccount" method="post" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="text-white bg-red-600 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center me-2">
                        Yes, Delete My Account
                    </button>
                </form>
                <button type="button" data-modal-hide="deleteAccountModal"
                        class="text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900 focus:z-10">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // Photo file change handling
        const photoFileInput = document.getElementById('photoFile');
        const currentPhoto = document.getElementById('currentPhoto');

        if (photoFileInput && currentPhoto) {
            photoFileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        currentPhoto.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        const changeEmailBtn = document.getElementById('changeEmailBtn');
        if (changeEmailBtn) {
            changeEmailBtn.addEventListener('click', function() {
                const newEmail = document.getElementById('email-address-icon').value;
                if (!newEmail) {
                    alert('Please enter a new email address');
                    return;
                }

                changeEmailBtn.disabled = true;
                const originalText = changeEmailBtn.innerHTML;
                changeEmailBtn.innerHTML = `<span class="inline-flex items-center"><span class="animate-pulse">.....</span></span>`;

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (!token) {
                    console.error('Anti-forgery token not found');
                    alert('Security token missing. Please refresh the page.');
                    changeEmailBtn.innerHTML = originalText;
                    changeEmailBtn.disabled = false;
                    return;
                }

                fetch('@Url.Action("RequestEmailChange", "Client")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ newEmail: newEmail })
                })

                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })

                .then(data => {
                    if (data.reload) {
                        window.location.reload();
                    } else {
                        changeEmailBtn.innerHTML = originalText;
                        changeEmailBtn.disabled = false;
                        if (data.success) {
                            alert(data.message || 'Email change request sent successfully!');
                        } else {
                            alert(data.message || 'An error occurred. Please try again.');
                        }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    changeEmailBtn.innerHTML = originalText;
                    changeEmailBtn.disabled = false;
                    alert('An error occurred. Please try again.');
                });
            });
        }
    });
</script>