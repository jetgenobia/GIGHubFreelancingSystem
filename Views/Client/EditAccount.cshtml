@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Account Details";
}
@model Freelancing.Models.EditAccount

<div class="p-4 sm:ml-64">
    <div class="p-4 mt-20">
        <div class="mt-4">
            <div class="block w-full p-6">
                <div class="flex items-center space-x-4">
                    <a href="@Url.Action("Profile", "Client")" class="text-blue-600 hover:text-blue-800">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h2 class="text-2xl font-bold text-gray-900">Manage Account</h2>
                </div>
                <form id="EditAccount" asp-action="EditAccount" method="post" class="p-4 md:p-5" enctype="multipart/form-data">
                    @if (!string.IsNullOrEmpty(ViewBag.Message as string))
                    {
                        <div class="mt-2 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
                            <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                            </svg>
                            <span class="sr-only">Success</span>
                            <div>
                                @Html.Raw(@ViewBag.Message)
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
                    {
                        <div class="mt-2 flex items-center p-4 mb-4 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50" role="alert">
                            <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                            </svg>
                            <span class="sr-only">Error</span>
                            <div>
                                @ViewBag.ErrorMessage
                            </div>
                        </div>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="mt-2 p-4 mb-4 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50" role="alert">
                            <div class="flex items-center mb-2">
                                <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                                </svg>
                                <span class="font-medium">Edit failed!</span>
                            </div>

                            <ul class="list-disc list-inside space-y-1">
                                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@modelError.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }
                    <input type="hidden" asp-for="Photo" />
                    <div class="grid gap-4 mb-4 grid-cols-2">
                        <div class="col-span-2 mb-2">
                            <label for="PhotoFile" class="block mb-2 text-sm font-medium text-gray-900">Profile Photo</label>
                            <div class="flex inline-flex items-start space-y-4">
                                <div class="relative inline-block">
                                    @if (!string.IsNullOrEmpty(Model.Photo))
                                    {
                                        <img id="currentPhoto"
                                             class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg"
                                             src="@Model.Photo"
                                             alt="user photo">
                                    }
                                    else
                                    {
                                        <img id="currentPhoto"
                                             class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-lg"
                                             src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497"
                                             alt="user photo">
                                    }
                                    <input type="file" id="photoFile" name="PhotoFile" accept="image/*" class="form-control hidden">
                                    <button type="button"
                                            onclick="document.getElementById('photoFile').click()"
                                            class="absolute bottom-0 right-0 bg-gray-200 hover:bg-gray-300 text-white rounded-full p-2 shadow-lg transition-colors duration-200 border-2 border-white">
                                        <svg viewBox="0 -2 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg" fill="#000000" class="w-4 h-4">
                                            <g stroke-width="0"></g>
                                            <g stroke-linecap="round" stroke-linejoin="round"></g>
                                            <g> <title>camera</title> <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"> <g transform="translate(-258.000000, -467.000000)" fill="#000000"> <path d="M286,471 L283,471 L282,469 C281.411,467.837 281.104,467 280,467 L268,467 C266.896,467 266.53,467.954 266,469 L265,471 L262,471 C259.791,471 258,472.791 258,475 L258,491 C258,493.209 259.791,495 262,495 L286,495 C288.209,495 290,493.209 290,491 L290,475 C290,472.791 288.209,471 286,471 Z M274,491 C269.582,491 266,487.418 266,483 C266,478.582 269.582,475 274,475 C278.418,475 282,478.582 282,483 C282,487.418 278.418,491 274,491 Z M274,477 C270.687,477 268,479.687 268,483 C268,486.313 270.687,489 274,489 C277.313,489 280,486.313 280,483 C280,479.687 277.313,477 274,477 L274,477 Z"> </path> </g> </g> </g>
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="col-span-2 sm:col-span-1">
                            <label asp-for="FirstName" class="block mb-2 text-sm font-medium text-gray-900">First Name</label>
                            <input asp-for="FirstName" class="form-control border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" required>
                        </div>

                        <div class="col-span-2 sm:col-span-1">
                            <label asp-for="LastName" class="block mb-2 text-sm font-medium text-gray-900">Last Name</label>
                            <input asp-for="LastName" class="form-control border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" required>
                        </div>

                        <div class="col-span-2 sm:col-span-1">
                            <label asp-for="Email" id="email-address" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">Email</label>
                            <div class="relative">
                                <input asp-for="Email" id="email-address-icon" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" required>
                                <button type="button" class="absolute inset-y-0 end-0 flex items-center px-3 rounded-r-lg bg-blue-700 hover:bg-blue-800 text-white text-sm" id="changeEmailBtn">
                                    Change
                                </button>
                            </div>
                            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                        </div>

                        <div class="col-span-2 sm:col-span-1">
                            <label asp-for="UserName" class="block mb-2 text-sm font-medium text-gray-900">Username</label>
                            <input asp-for="UserName" class="form-control border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" required>
                        </div>
                        <div class="col-span-2">
                            <label asp-for="Bio" class="block mb-2 text-sm font-medium text-gray-900">Bio</label>
                            <textarea asp-for="Bio" rows="4" class="form-control block p-2.5 w-full text-sm text-gray-900 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500" placeholder="Write your bio here"></textarea>
                        </div>
                    </div>

                    <div class="flex justify-end">
                        <button type="submit"
                                class="text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        
        // Photo file change handling
        const photoFileInput = document.getElementById('photoFile');
        const currentPhoto = document.getElementById('currentPhoto');

        if (photoFileInput && currentPhoto) {
            photoFileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        currentPhoto.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                }
            });
        }

        const changeEmailBtn = document.getElementById('changeEmailBtn');
        if (changeEmailBtn) {
            changeEmailBtn.addEventListener('click', function() {
                const newEmail = document.getElementById('email-address-icon').value;
                if (!newEmail) {
                    alert('Please enter a new email address');
                    return;
                }

                changeEmailBtn.disabled = true;
                const originalText = changeEmailBtn.innerHTML;
                changeEmailBtn.innerHTML = `<span class="inline-flex items-center"><span class="animate-pulse">.....</span></span>`;

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (!token) {
                    console.error('Anti-forgery token not found');
                    alert('Security token missing. Please refresh the page.');
                    changeEmailBtn.innerHTML = originalText;
                    changeEmailBtn.disabled = false;
                    return;
                }

                fetch('@Url.Action("RequestEmailChange", "Client")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ newEmail: newEmail })
                })

                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })

                .then(data => {
                    if (data.reload) {
                        window.location.reload();
                    } else {
                        changeEmailBtn.innerHTML = originalText;
                        changeEmailBtn.disabled = false;
                        if (data.success) {
                            alert(data.message || 'Email change request sent successfully!');
                        } else {
                            alert(data.message || 'An error occurred. Please try again.');
                        }
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    changeEmailBtn.innerHTML = originalText;
                    changeEmailBtn.disabled = false;
                    alert('An error occurred. Please try again.');
                });
            });
        }
    });
</script>