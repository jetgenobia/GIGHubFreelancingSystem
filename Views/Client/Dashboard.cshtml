@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Dashboard";
}

@model Freelancing.Models.ClientDashboard
@using Freelancing.Helpers

<div class="p-4 sm:ml-64">
    <div class="pt-2 mt-20">
        <div class="block w-full p-6">
            @if (!string.IsNullOrEmpty(ViewBag.Message as string))
            {
                <div class="mt-2 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
                    <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                    </svg>
                    <span class="sr-only">Success</span>
                    <div>
                        <span class="font-medium">Success!</span> @ViewBag.Message
                    </div>
                </div>
            }
            @if (TempData["Message"] != null)
            {
                <div class="mt-4 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
                    <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                    </svg>
                    <span class="sr-only">Success</span>
                    <div>
                        <span class="font-medium">Success!</span> @TempData["Message"]
                    </div>
                </div>
            }
            <div class="mb-4">
                <h4 class="text-2xl text-dark font-bold">
                    Hello, @User.FindFirst("FullName")?.Value
                </h4>
            </div>

            <div class="w-full p-4 mb-4 text-left bg-white border border-gray-200 rounded-lg shadow-sm sm:p-8 dark:bg-gray-800 dark:border-gray-700">
                <h5 class="mb-2 text-3xl font-bold text-gray-900 dark:text-white">Total Posted Projects</h5>
                <div class="flex items-center justify-between">
                    <h5 id="totalPostedProject" class="mb-2 text-3xl font-bold text-gray-900 dark:text-white">@Model.TotalProjects</h5>
                    <a asp-controller="Client" asp-action="Post" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700">
                        Post Project
                    </a>
                </div>
            </div>

            @{
                // Get all active projects
                var allActiveProjects = (Model.Projects ?? Enumerable.Empty<dynamic>())
                .Where(p => !string.IsNullOrWhiteSpace((string?)p.Status) &&
                string.Equals((string?)p.Status, "Active", StringComparison.OrdinalIgnoreCase) &&
                !((HashSet<Guid>)ViewBag.TerminatedProjectIds).Contains(p.Id))
                .ToList();

                var activeProjectsCount = allActiveProjects.Count();

                // Get all posted projects (Open status)
                var allPostedProjects = (Model.Projects ?? Enumerable.Empty<dynamic>())
                .Where(p => !string.IsNullOrWhiteSpace((string?)p.Status) &&
                string.Equals((string?)p.Status, "Open", StringComparison.OrdinalIgnoreCase))
                .ToList();

                var postedProjectsCount = allPostedProjects.Count();

                // Get all given feedbacks count
                var allGivenFeedbacks = (Model.freelancerFeedbacks ?? new List<Freelancing.Models.Entities.FreelancerFeedback>()).ToList();
                var givenFeedbacksCount = allGivenFeedbacks.Count();
            }
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Active Projects</h5>
                        <a asp-action="ActiveProjects" asp-controller="Client" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View All</a>
                    </div>
                    <div class="flow-root">
                        <h5 class="mb-2 text-3xl font-bold text-gray-900">@activeProjectsCount</h5>
                    </div>
                </div>

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Open Projects</h5>
                        <a asp-action="Postings" asp-controller="Client" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View All</a>
                    </div>
                    <div class="flow-root">
                        <h5 class="mb-2 text-3xl font-bold text-gray-900">@postedProjectsCount</h5>
                    </div>
                </div>

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Given Feedbacks</h5>
                        <a asp-action="Feedbacks" asp-controller="Client" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View All</a>
                    </div>
                    <div class="flow-root">
                        <h5 class="mb-2 text-3xl font-bold text-gray-900">@givenFeedbacksCount</h5>
                    </div>
                </div>

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Spending Summary</h5>
                        <p class="text-sm italic font-light">Based on the budget of all accepted bids</p>
                    </div>
                    <div class="flow-root">
                        <h5 id="totalPostedProject" class="mb-2 text-3xl font-bold text-gray-900"><span class="mr-2">₱</span>@ViewBag.TotalAcceptedBudget</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>