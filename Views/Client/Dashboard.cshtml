@{
    Layout = "_LayoutClient";
    ViewData["Title"] = "Dashboard";
}

@model Freelancing.Models.ClientDashboard

<div class="p-4 sm:ml-64">
    <div class="pt-2 mt-20">
        <div class="block w-full p-6">
            @if (!string.IsNullOrEmpty(ViewBag.Message as string))
            {
                <div class="mt-2 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
                    <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                    </svg>
                    <span class="sr-only">Success</span>
                    <div>
                        <span class="font-medium">Success!</span> @ViewBag.Message
                    </div>
                </div>
            }

            <div class="mb-4">
                <h4 class="text-2xl text-dark font-bold">
                    Hello, @User.FindFirst("FullName")?.Value
                </h4>
            </div>

            <div class="w-full p-4 mb-4 text-left bg-white border border-gray-200 rounded-lg shadow-sm sm:p-8 dark:bg-gray-800 dark:border-gray-700">
                <h5 class="mb-2 text-3xl font-bold text-gray-900 dark:text-white">Total Posted Projects</h5>
                <div class="flex items-center justify-between">
                    <h5 id="totalPostedProject" class="mb-2 text-3xl font-bold text-gray-900 dark:text-white">@Model.TotalProjects</h5>
                    <a asp-controller="Client" asp-action="Post" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:hover:border-gray-600 dark:focus:ring-gray-700">
                        Post Project
                    </a>
                </div>
            </div>

            @{
                var activeProjects = (Model.Projects ?? Enumerable.Empty<dynamic>())
                .Where(p => !string.IsNullOrWhiteSpace((string?)p.Status) &&
                string.Equals((string?)p.Status, "Active", StringComparison.OrdinalIgnoreCase) &&
                !((HashSet<Guid>)ViewBag.TerminatedProjectIds).Contains(p.Id))
                .Take(3)
                .ToList();
            }
            <div class="grid grid-cols-1 gap-4 mb-4">
                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Active Projects</h5>
                        <a asp-action="ActiveProjects" asp-controller="Client" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View All</a>
                    </div>
                    <div class="flow-root">
                        <ul role="list" class="divide-y divide-gray-300">
                            @if (activeProjects.Any())
                            {
                                @foreach (var project in activeProjects)
                                {
                                    <li class="py-3 sm:py-4">
                                        <div class="flex items-center">
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm font-medium text-gray-900 truncate">
                                                    @project.ProjectName
                                                </p>
                                                <p class="text-xs text-gray-500">
                                                    Freelancer: @(project.AcceptedBid?.User != null ? $"{project.AcceptedBid.User.FirstName} {project.AcceptedBid.User.LastName}" : "—")
                                                </p>
                                            </div>
                                            <div class="inline-flex items-center text-base font-semibold text-gray-900">
                                                <a class="text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-6 py-2 me-2 mb-2"
                                                   asp-controller="ManageProjectClient" asp-action="Details" asp-route-id="@project.Id"> View </a>
                                            </div>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="py-3 sm:py-4 text-center">
                                    <div class="text-sm text-gray-500">No active projects.</div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Manage Biddings</h5>
                        <a asp-action="Biddings" asp-controller="Client" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View All</a>
                    </div>
                    <div class="flow-root">
                        <ul role="list" class="divide-y divide-gray-300">
                            @{
                                var biddingProjects = (Model.Projects ?? Enumerable.Empty<Freelancing.Models.Entities.Project>())
                                .Where(p => p.AcceptedBidId == null)
                                .Take(3)
                                .ToList();
                            }

                            @if (biddingProjects.Any())
                            {
                                @foreach (var project in biddingProjects)
                                {
                                    <li class="py-3 sm:py-4">
                                        <div class="flex items-center">
                                            <div class="flex-1 min-w-0">
                                                <p class="me-1 text-sm font-medium text-gray-900 truncate">
                                                    @project.ProjectName
                                                </p>
                                                <p class="text-xs text-gray-500">Created: @project.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</p>
                                            </div>
                                            <div class="inline-flex items-center text-base font-semibold text-gray-900">
                                                <a class="text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-3 py-2 me-2 mb-2"
                                                   asp-controller="Client" asp-action="ManageBid" asp-route-id="@project.Id"> Manage </a>
                                            </div>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="py-3 sm:py-4 text-center">
                                    <div class="text-sm text-gray-500">No projects currently open for bidding.</div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Manage Postings</h5>
                        <a asp-action="Postings" asp-controller="Client" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View All</a>
                    </div>
                    <div class="flow-root">
                        <ul role="list" class="divide-y divide-gray-300">
                            @{
                                var postings = (Model.Projects ?? Enumerable.Empty<Freelancing.Models.Entities.Project>())
                                .Where(p => p.AcceptedBidId == null)
                                .Take(3)
                                .ToList();
                            }

                            @if (postings.Any())
                            {
                                @foreach (var project in postings)
                                {
                                    <li class="py-3 sm:py-4">
                                        <div class="flex items-center">
                                            <div class="flex-1 min-w-0">
                                                <p class="me-1 text-sm font-medium text-gray-900 truncate">
                                                    @project.ProjectName
                                                </p>
                                                <p class="text-xs text-gray-500">Created: @project.CreatedAt.ToString("MMM dd, yyyy 'at' h:mm tt")</p>
                                            </div>
                                            <div class="inline-flex items-center text-base font-semibold text-gray-900">
                                                <a class="text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-3 py-2 me-2 mb-2"
                                                   asp-controller="Client" asp-action="EditPost" asp-route-id="@project.Id"> Edit </a>
                                            </div>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="py-3 sm:py-4 text-center">
                                    <div class="text-sm text-gray-500">No projects currently open for bidding.</div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>


                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Spending Summary</h5>
                        <p class="text-sm italic font-light">Based on the budget of all accepted bids</p>
                    </div>
                    <div class="flow-root">
                        <h5 id="totalPostedProject" class="mb-2 text-3xl font-bold text-gray-900"><span class="mr-2">₱</span>@ViewBag.TotalAcceptedBudget</h5>
                    </div>
                </div>


                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="flex items-center justify-between mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Given Feedbacks</h5>
                        <a asp-action="Feedbacks" asp-controller="Client" type="button" class="text-gray-900 bg-white border border-gray-300 focus:outline-none hover:bg-gray-100 focus:ring-4 focus:ring-gray-100 font-medium rounded-full text-xs px-3 py-1.5 me-2 mb-2">View All</a>
                    </div>
                    <div class="flow-root">
                        <ul role="list" class="divide-y divide-gray-300">
                            @{
                                var feedbacksList = (Model.freelancerFeedbacks ?? new List<Freelancing.Models.Entities.FreelancerFeedback>())
                                .Take(3)
                                .ToList();
                            }

                            @foreach (var feedbacks in feedbacksList)
                            {
                                <li class="py-3 sm:py-4">
                                    <div class="flex items-center">
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-gray-900 truncate">
                                                @(
                                                                                            feedbacks.AcceptBidding?.Project != null
                                                                                            ? feedbacks.AcceptBidding.Project.ProjectName
                                                                                            : "Unknown project"
                                                                                            )
                                        </p>
                                        <p class="text-xs text-gray-500">
                                            To: @(feedbacks.Freelancer != null ? $"{feedbacks.Freelancer.FirstName} {feedbacks.Freelancer.LastName}" : feedbacks.FreelancerId) • @feedbacks.Rating star(s)
                                        </p>
                                    </div>
                                    <div class="inline-flex items-center text-base font-semibold text-gray-900">
                                        @{
                                                var projectId = feedbacks.AcceptBidding?.Project?.Id;
                                            }
                                            @if (projectId != null)
                                            {
                                                <a class="text-white bg-gray-800 hover:bg-gray-900 focus:outline-none focus:ring-4 focus:ring-gray-300 font-medium rounded-lg text-sm px-6 py-2 me-2 mb-2"
                                                   asp-controller="ManageProjectClient" asp-action="Feedback" asp-route-id="@feedbacks.AcceptBidId"> View </a>
                                            }
                                        </div>
                                    </div>
                                </li>
                            }

                            @if (!feedbacksList.Any())
                            {
                                <li class="py-3 sm:py-4 text-center">
                                    <div class="text-sm text-gray-500">No feedback sent yet.</div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 gap-4 mb-4">
                <div class="w-full max-w p-4 bg-white border border-gray-300 rounded-lg shadow-sm sm:p-8">
                    <div class="mb-4">
                        <h5 class="text-xl font-bold leading-none text-gray-900">Reports</h5>
                        <p class="text-sm italic font-light">Select Report Range</p>
                    </div>
                    @await Html.PartialAsync("_ReportButtons")
                </div>
            </div>
        </div>
    </div>
</div>