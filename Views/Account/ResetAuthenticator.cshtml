@{
    Layout = User.IsInRole("Client") ? "_LayoutClient" : "_LayoutFreelancer";
    ViewData["Title"] = "Reset Authenticator";
    var userIsClient = User.IsInRole("Client");
    var userIsFreelancer = User.IsInRole("Freelancer");
}

<div class="p-4 sm:ml-64">
    <div class="p-4 mt-20">
        <div class="mt-15">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-xl font-semibold mb-4">Reset authenticator app</h2>
                <p class="mb-4 text-sm text-gray-700">Resetting will remove your current authenticator key and disable 2FA. You will need to reconfigure your authenticator app.</p>

                <form asp-action="ResetAuthenticatorConfirmed" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="focus:outline-none text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2">Reset authenticator and reconfigure</button>
                </form>
            </div>
        </div>
    </div>
</div>