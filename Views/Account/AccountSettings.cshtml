@section Scripts {
    <script src="~/js/password-validation.js" asp-append-version="true"></script>

    <script>
        (function () {
            // Password visibility toggle functionality
            function setupPasswordToggle(toggleButtonId, passwordInputId, eyeOpenId, eyeClosedId) {
                const toggleButton = document.getElementById(toggleButtonId);
                const passwordInput = document.getElementById(passwordInputId);
                const eyeOpen = document.getElementById(eyeOpenId);
                const eyeClosed = document.getElementById(eyeClosedId);

                if (toggleButton && passwordInput && eyeOpen && eyeClosed) {
                    toggleButton.addEventListener('click', function() {
                        if (passwordInput.type === 'password') {
                            passwordInput.type = 'text';
                            eyeOpen.classList.add('hidden');
                            eyeClosed.classList.remove('hidden');
                        } else {
                            passwordInput.type = 'password';
                            eyeOpen.classList.remove('hidden');
                            eyeClosed.classList.add('hidden');
                        }
                    });
                }
            }

            // Setup all password toggles
            setupPasswordToggle('toggleCurrentPassword', 'current-password-icon', 'eyeOpenCurrent', 'eyeClosedCurrent');
            setupPasswordToggle('togglePassword', 'password-icon', 'eyeOpen', 'eyeClosed');
            setupPasswordToggle('toggleConfirmPassword', 'confirm-password-icon', 'eyeOpenConfirm', 'eyeClosedConfirm');

            // Rest of your existing script code...
            const enableBtn = document.getElementById('enable-2fa-btn');
            const authContainer = document.getElementById('authenticator-setup-container');
            const qrImg = document.getElementById('authenticator-qr');
            const sharedKeyEl = document.getElementById('authenticator-shared-key');
            const cancelBtn = document.getElementById('cancel-auth-setup');

            // Helper to show/hide the enable button
            function setEnableButtonVisible(visible) {
                if (!enableBtn) return;
                enableBtn.style.display = visible ? '' : 'none';
            }

            // If the authenticator setup is already visible server-side, hide the enable button
            try {
                if (authContainer && authContainer.style.display !== 'none') {
                    setEnableButtonVisible(false);
                }
            } catch (e) {
                // ignore
            }

            if (enableBtn) {
                enableBtn.addEventListener('click', async function () {
                    // immediate UI feedback
                    enableBtn.disabled = true;
                    enableBtn.classList.add('opacity-70', 'cursor-not-allowed');

                    try {
                        const res = await fetch('@Url.Action("GetAuthenticatorSetup", "Account")', {
                            method: 'GET',
                            credentials: 'same-origin',
                            headers: { 'Accept': 'application/json' }
                        });

                        if (!res.ok) {
                            throw new Error('Failed to get authenticator setup.');
                        }

                        const data = await res.json();
                        if (!data || !data.ok) throw new Error('Failed to get authenticator setup.');

                        // populate UI
                        if (data.qrImage) {
                            qrImg.src = data.qrImage;
                            qrImg.classList.remove('hidden');
                        }

                        sharedKeyEl.textContent = data.sharedKey || '';
                        authContainer.style.display = '';

                        // hide the enable button now that setup UI is shown
                        setEnableButtonVisible(false);

                        // bring into view
                        authContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    } catch (err) {
                        console.error(err);
                        alert('Unable to prepare authenticator setup. Try again or contact support.');
                        // restore button
                        setEnableButtonVisible(true);
                    } finally {
                        enableBtn.disabled = false;
                        enableBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                    }
                });
            }

            if (cancelBtn) {
                cancelBtn.addEventListener('click', function () {
                    // hide the setup UI and show enable button again
                    if (authContainer) authContainer.style.display = 'none';
                    // clear QR & key
                    if (qrImg) {
                        qrImg.src = '';
                        qrImg.classList.add('hidden');
                    }
                    if (sharedKeyEl) sharedKeyEl.textContent = '';
                    setEnableButtonVisible(true);

                    // optional: focus enable button
                    if (enableBtn) enableBtn.focus();
                });
            }

            // Modal open/close for Reset Authenticator
            const openResetBtn = document.getElementById('openResetAuthenticatorModal');
            const resetModal = document.getElementById('resetAuthenticatorModal');
            function showModal(modal) {
                if (!modal) return;
                modal.classList.remove('hidden');
            }
            function hideModal(modal) {
                if (!modal) return;
                modal.classList.add('hidden');
            }
            if (openResetBtn && resetModal) {
                openResetBtn.addEventListener('click', function () {
                    showModal(resetModal);
                    // focus first button
                    const confirmBtn = resetModal.querySelector('button[type="submit"]');
                    if (confirmBtn) confirmBtn.focus();
                });
            }
            // close buttons inside modal: data-modal-hide
            document.querySelectorAll('[data-modal-hide]').forEach(btn => {
                btn.addEventListener('click', function (e) {
                    const target = btn.getAttribute('data-modal-hide');
                    if (!target) return;
                    const modalEl = document.getElementById(target);
                    if (modalEl) hideModal(modalEl);
                });
            });

        })();
    </script>
}