@model Freelancing.Models.AccountSettingsViewModel
@{
    Layout = User.IsInRole("Client") ? "_LayoutClient" : "_LayoutFreelancer";
    ViewData["Title"] = "Account Settings";
    var userIsClient = User.IsInRole("Client");
    var userIsFreelancer = User.IsInRole("Freelancer");
}
<style>
    /* Password validation styles (copied from Registration) */
    .password-requirement {
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 0;
    }

        .password-requirement.valid {
            color: #059669;
        }

        .password-requirement.invalid {
            color: #dc2626;
        }

    .password-strength-bar {
        height: 6px;
        border-radius: 3px;
        transition: all 0.3s ease;
        margin-top: 8px;
    }

    .strength-weak {
        background: linear-gradient(to right, #dc2626 0%, #dc2626 33%, #e5e7eb 33%, #e5e7eb 100%);
    }

    .strength-medium {
        background: linear-gradient(to right, #d97706 0%, #d97706 66%, #e5e7eb 66%, #e5e7eb 100%);
    }

    .strength-strong {
        background: linear-gradient(to right, #059669 0%, #059669 100%);
    }

    .validation-icon {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .border-red-validation {
        border-color: #dc2626 !important;
    }

    .border-green-validation {
        border-color: #059669 !important;
    }
</style>

<div class="p-4 sm:ml-64">
    <div class="pt-2 mt-20">
        <div class="mt-1">
            <div class="block w-full p-6">
                <div class="flex items-center space-x-4 mb-6">
                    <a href="javascript:history.back()" class="text-blue-600 hover:text-blue-800">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h2 class="text-2xl font-bold text-gray-900">Account Settings</h2>
                </div>
                <div class="space-y-4">
                    <div class="border border-gray-200 rounded-lg p-4 bg-white">
                        <h3 class="text-lg font-medium text-gray-900 mb-6">Change Password</h3>
                        @if (TempData["ChangePasswordSuccess"] != null || ViewBag.Message != null)
                        {
                            var successMessage = TempData["ChangePasswordSuccess"] ?? ViewBag.Message;
                            <div class="mt-2 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
                                <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                                </svg>
                                <span class="sr-only">Success</span>
                                <div>
                                    <span class="font-medium">Success!</span> @successMessage
                                </div>
                            </div>
                        }
                        <form asp-action="ChangePassword" method="post">

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="mt-2 p-4 mb-4 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50" role="alert">
                                    <div class="flex items-center mb-2">
                                        <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                                        </svg>
                                        <span class="font-medium">Password reset failed!</span>
                                    </div>

                                    <ul class="list-disc list-inside space-y-1">
                                        @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                        {
                                            <li>@modelError.ErrorMessage</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @Html.AntiForgeryToken()
                            <label asp-for="CurrentPassword" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">Current Password</label>
                            <div class="relative">
                                <input asp-for="CurrentPassword" id="current-password-icon" type="password" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="" required>
                                <button type="button" id="toggleCurrentPassword" class="absolute inset-y-0 end-0 flex items-center pe-3 cursor-pointer">
                                    <svg id="eyeOpenCurrent" class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path>
                                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"></path>
                                    </svg>
                                    <svg id="eyeClosedCurrent" class="w-5 h-5 text-gray-500 hidden" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"></path>
                                        <path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z"></path>
                                    </svg>
                                </button>
                            </div>

                            <label asp-for="NewPassword" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">New Password</label>
                            <div class="relative">
                                <!-- NewPassword uses the ids expected by password-validation.js -->
                                <input asp-for="NewPassword" id="password-icon" type="password" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="" required>
                                <button type="button" id="togglePassword" class="absolute inset-y-0 end-0 flex items-center pe-3 cursor-pointer">
                                    <svg id="eyeOpen" class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path>
                                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"></path>
                                    </svg>
                                    <svg id="eyeClosed" class="w-5 h-5 text-gray-500 hidden" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"></path>
                                        <path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z"></path>
                                    </svg>
                                </button>
                            </div>

                            <div id="passwordRequirements" class="mt-3 p-3 hidden">
                                <div class="text-sm font-medium text-gray-700 mb-2">Password Requirements:</div>
                                <div id="lengthReq" class="password-requirement invalid text-xs">
                                    <svg class="validation-icon" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                    </svg>
                                    At least 8 characters
                                </div>
                                <div id="upperReq" class="password-requirement invalid text-xs">
                                    <svg class="validation-icon" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                    </svg>
                                    At least one uppercase letter
                                </div>
                                <div id="lowerReq" class="password-requirement invalid text-xs">
                                    <svg class="validation-icon" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                    </svg>
                                    At least one lowercase letter
                                </div>
                                <div id="numberReq" class="password-requirement invalid text-xs">
                                    <svg class="validation-icon" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                    </svg>
                                    At least one number
                                </div>
                                <div id="specialReq" class="password-requirement invalid text-xs">
                                    <svg class="validation-icon" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                                    </svg>
                                    At least one special character
                                </div>

                                <!-- Password Strength Bar -->
                                <div class="mt-3">
                                    <div class="flex justify-between text-xs text-gray-600 mb-1">
                                        <span>Password Strength:</span>
                                        <span id="strengthText">Weak</span>
                                    </div>
                                    <div id="strengthBar" class="password-strength-bar bg-gray-200"></div>
                                </div>
                            </div>

                            <label asp-for="ConfirmNewPassword" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">Confirm New Password</label>
                            <div class="relative">
                                <input asp-for="ConfirmNewPassword" id="confirm-password-icon" type="password" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="" required>
                                <button type="button" id="toggleConfirmPassword" class="absolute inset-y-0 end-0 flex items-center pe-3 cursor-pointer">
                                    <svg id="eyeOpenConfirm" class="w-5 h-5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"></path>
                                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"></path>
                                    </svg>
                                    <svg id="eyeClosedConfirm" class="w-5 h-5 text-gray-500 hidden" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M3.707 2.293a1 1 0 00-1.414 1.414l14 14a1 1 0 001.414-1.414l-1.473-1.473A10.014 10.014 0 0019.542 10C18.268 5.943 14.478 3 10 3a9.958 9.958 0 00-4.512 1.074l-1.78-1.781zm4.261 4.26l1.514 1.515a2.003 2.003 0 012.45 2.45l1.514 1.514a4 4 0 00-5.478-5.478z" clip-rule="evenodd"></path>
                                        <path d="M12.454 16.697L9.75 13.992a4 4 0 01-3.742-3.741L2.335 6.578A9.98 9.98 0 00.458 10c1.274 4.057 5.065 7 9.542 7 .847 0 1.669-.105 2.454-.303z"></path>
                                    </svg>
                                </button>
                            </div>

                            <div id="passwordMatchMessage" class="mt-2 text-xs hidden"></div>
                            <div class="flex items-end justify-end">
                                <button type="submit" class="mt-5 text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">Change Password</button>
                            </div>
                        </form>
                    </div>

                    <div class="border border-gray-200 rounded-lg p-4 bg-white">
                        <h3 class="text-lg font-medium text-gray-900 mb-6">Two-Factor Authentication</h3>
                        @if (TempData["Message"] != null)
                        {
                            <div class="mt-4 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
                                <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                                </svg>
                                <span class="sr-only">Success</span>
                                <div>
                                    <span class="font-medium">Success!</span> @TempData["Message"]
                                </div>
                            </div>
                        }
                        @if (TempData["Error"] != null)
                        {
                            <div class="mt-4 flex items-center p-4 mb-4 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50" role="alert">
                                <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                                </svg>
                                <span class="sr-only">Error</span>
                                <div>
                                    <span class="font-medium">Error:</span> @TempData["Error"]
                                </div>
                            </div>
                        }

                        @if (Model.RecoveryCodes != null && Model.RecoveryCodes.Length > 0)
                        {
                            <div class="mb-4">
                                <p class="mb-2 text-sm">Save these recovery codes in a safe place. Each code can be used once if you lose your authenticator app.</p>
                                <div class="grid grid-cols-2 gap-2 mb-4">
                                    @foreach (var c in Model.RecoveryCodes)
                                    {
                                        <div class="p-2 bg-gray-100 rounded font-mono text-sm">@c</div>
                                    }
                                </div>

                                <form asp-action="ConfirmRecoveryCodesSaved" method="post">
                                    @Html.AntiForgeryToken()
                                    <div class="flex items-end justify-end">
                                        <button type="submit" class="mt-5 text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">I have saved these codes</button>
                                    </div>
                                </form>
                            </div>
                        }
                        @if (Model.IsTwoFactorEnabled)
                        {
                            <div class="mb-4">
                                <p class="text-xs italic">Your account is currently protected by two-factor authentication.</p>
                                <p class="text-xs italic mb-2">If you wish to generate a new backup code / reset authenticator please click the button below.</p>
                                <div class="mb-6 flex gap-4">
                                    <button id="openResetAuthenticatorModal" type="button" class="inline-flex items-center text-white bg-gray-800 hover:bg-gray-900 rounded-lg text-sm px-5 py-2.5">
                                        <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.5 11.5 11 13l4-3.5M12 20a16.405 16.405 0 0 1-5.092-5.804A16.694 16.694 0 0 1 5 6.666L12 4l7 2.667a16.695 16.695 0 0 1-1.908 7.529A16.406 16.406 0 0 1 12 20Z" /></svg>
                                        Reset
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Show enable control or QR + verify or recovery codes -->
                            @if (!Model.ShowEnableAuthenticator && (Model.RecoveryCodes == null || Model.RecoveryCodes.Length == 0))
                            {
                                <div class="mb-4">
                                    <div class="mb-6 flex gap-4">
                                        <button id="enable-2fa-btn" type="button" class="inline-flex items-center text-white bg-gray-800 hover:bg-gray-900 rounded-lg text-sm px-5 py-2.5">
                                            <svg class="w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 20a16.405 16.405 0 0 1-5.092-5.804A16.694 16.694 0 0 1 5 6.666L12 4l7 2.667a16.695 16.695 0 0 1-1.908 7.529A16.406 16.406 0 0 1 12 20Z" /></svg>
                                            Enable
                                        </button>
                                    </div>
                                </div>
                            }

                            <div id="authenticator-setup-container" style="@(Model.ShowEnableAuthenticator ? "" : "display:none")">
                                <div class="flex flex-col md:flex-row md:items-start md:gap-6 mb-4">
                                    <div class="mb-4 md:mb-0">
                                        @if (!string.IsNullOrEmpty(Model.QrCodeImageUrl))
                                        {
                                            <div class="flex items-center justify-center">
                                                <img id="authenticator-qr" src="@Model.QrCodeImageUrl" alt="QR code" loading="lazy" class="w-auto h-48 border border-gray-300 p-2 bg-white rounded" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex items-center justify-center">
                                                <img id="authenticator-qr" src="" alt="QR code" loading="lazy" class="w-auto h-48 border border-gray-300 p-2 bg-white rounded hidden" />
                                            </div>
                                        }
                                    </div>

                                    <div class="flex-1">
                                        <p class="text-sm mb-2 text-center md:text-left">If you cannot scan the QR code, enter this key into your authenticator app:</p>
                                        <div id="authenticator-shared-key" class="p-2 bg-gray-100 rounded font-mono break-all inline-block mb-3">@Model.SharedKey</div>
                                        <p class="text-xs mt-3 text-gray-600 text-center md:text-left">Then enter a verification code from your authenticator app below.</p>

                                        <form asp-action="EnableAuthenticator" method="post" class="mt-4">
                                            @Html.AntiForgeryToken()
                                            <div class="mb-3">
                                                <label class="block text-sm font-medium">Verification code</label>
                                                <input name="VerificationCode" value="@Model.VerificationCode" class="mt-1 bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" />
                                            </div>
                                            <div class="flex items-end justify-end gap-2">
                                                <button type="submit" class="focus:outline-none text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5">Verify and enable</button>
                                                <button id="cancel-auth-setup" type="button" class="inline-flex items-center text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg text-sm px-4 py-2.5">Cancel</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="border border-gray-200 rounded-lg p-4 bg-white">
                        <h3 class="text-lg font-medium text-gray-900 mb-6">Delete Account</h3>
                        <div class="mb-4">
                            @if (TempData["DeleteAccountError"] != null)
                            {
                                <div class="mt-4 flex items-center p-4 mb-4 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50" role="alert">
                                    <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                                    </svg>
                                    <span class="sr-only">Error</span>
                                    <div>
                                        <span class="font-medium">Error:</span> @TempData["DeleteAccountError"]
                                    </div>
                                </div>
                            }
                            <div class="mb-6 flex gap-4">
                                <button type="button"
                                        data-modal-target="deleteAccountModal"
                                        data-modal-toggle="deleteAccountModal"
                                        class="text-white inline-flex items-center bg-red-700 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">
                                    <svg class="w-4 h-4 mr-2" fill="#ffffff" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M1,20a1,1,0,0,0,1,1h8a1,1,0,0,0,0-2H3.071A7.011,7.011,0,0,1,10,13a5.044,5.044,0,1,0-3.377-1.337A9.01,9.01,0,0,0,1,20ZM10,5A3,3,0,1,1,7,8,3,3,0,0,1,10,5Zm12.707,9.707L20.414,17l2.293,2.293a1,1,0,1,1-1.414,1.414L19,18.414l-2.293,2.293a1,1,0,0,1-1.414-1.414L17.586,17l-2.293-2.293a1,1,0,0,1,1.414-1.414L19,15.586l2.293-2.293a1,1,0,0,1,1.414,1.414Z"></path></g></svg>
                                    Delete Account
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reset Authenticator Confirmation Modal (centered) -->
<div id="resetAuthenticatorModal" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed inset-0 z-50 flex justify-center items-center w-full h-full backdrop-blur-sm bg-black/30">
