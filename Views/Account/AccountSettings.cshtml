                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></path>
                </svg>
                <h3 class="mb-3 text-lg font-semibold text-gray-900">Reset Authenticator</h3>
                <p class="mb-4 text-sm text-gray-500">This will reset your two-factor authenticator and disable 2FA for your account. You will need to re-enable 2FA and generate new recovery codes.</p>

                <form method="post" asp-controller="Account" asp-action="ResetAuthenticatorConfirmed" class="inline">
                    @Html.AntiForgeryToken()
