@model Freelancing.Models.RegistrationViewModel

@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]Sign Up</title>
	<link rel="stylesheet" href="~/css/output.css" />
	<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
	<style>
		.page-background {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-repeat: no-repeat;
			z-index: -1;
			background-image: url('https://ik.imagekit.io/6txj3mofs/Desktop.png?updatedAt=1758112480559');
			background-size: cover;
			background-position: center right;
		}

		@@media (max-width: 1024px) {
			.page-background {
				background-image: url('https://ik.imagekit.io/6txj3mofs/Untitled%20design%20(5).png');
				background-position: center;
			}
		}

		@@media (max-width: 640px) {
			.page-background {
				background-image: url('https://ik.imagekit.io/6txj3mofs/Untitled%20design%20(6).png');
				background-size: cover;
				background-position: center;
			}
		}
	</style>
</head>
<body class="min-h-screen flex items-center justify-center">
	<div class="page-background"></div>
	<header id="site-header" class="slide-up-init fixed inset-x-0 top-0 z-50 px-4">
		<nav class="flex items-center justify-between p-6 lg:px-8" aria-label="Global">
			<div class="flex lg:flex-1">
				<a class="-m-1.5 p-2" asp-area="" asp-controller="Home" asp-action="Index">
					<span class="sr-only">Your Company</span>
					<img class="h-20 w-auto" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(2).png?updatedAt=1749718355580" alt="">
				</a>
			</div>
		</nav>
	</header>

	<div class="relative">
		<div class="relative isolate px-6 pt-[10px] lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 items-center py-16 sm:py-24 lg:py-32 px-4">
				<div class="flex items-center justify-center w-full">
					<div class="w-1/2 flex flex-col items-center justify-center p-6 bg-white border border-gray-200 rounded-lg shadow">
						<div class="mb-5">
							<h5 class="mb-2 text-2xl font-bold text-gray-900">Sign Up</h5>
						</div>
						<div class="w-full">
							<form asp-action="Registration" id="signupForm">
								<div id="firstPart" class="signup-content">
									@if (!string.IsNullOrEmpty(ViewBag.Message as string))
									{
										<div class="mt-2 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
											<svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
												<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
											</svg>
											<span class="sr-only">Success</span>
											<div>
												<span class="font-medium">Success!</span> @ViewBag.Message
											</div>
										</div>
									}
									<label asp-for="Role" id="role-address" class="control-label block mb-2 text-sm font-medium text-gray-900">Role</label>
									<div class="relative">
										<select asp-for="Role" id="role-address-icon" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-500 focus:border-primary-500 block w-full p-2.5" required>
											<option value="">Select a Role</option>
											<option value="Freelancer">Freelancer</option>
											<option value="Client">Client</option>
										</select>
									</div>
									<label asp-for="FirstName" id="firstname-address" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">First Name</label>
									<div class="relative">
										<div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
											<svg class="w-6 h-6 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
												<path fill-rule="evenodd" d="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4h-4Z" clip-rule="evenodd" />
											</svg>
										</div>
										<input asp-for="FirstName" id="firstname-address-icon" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-2.5" placeholder="" required>
									</div>
									<label asp-for="LastName" id="lastname-address" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">Last Name</label>
									<div class="relative">
										<div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
											<svg class="w-6 h-6 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
												<path fill-rule="evenodd" d="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4h-4Z" clip-rule="evenodd" />
											</svg>
										</div>
										<input asp-for="LastName" id="lastname-address-icon" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-2.5" placeholder="" required>
									</div>
									@if (!ViewData.ModelState.IsValid)
									{
										<div class="mt-2 p-4 mb-4 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50" role="alert">
											<div class="flex items-center mb-2">
												<svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
													<path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
												</svg>
												<span class="font-medium">Registration failed!</span>
											</div>

											<ul class="list-disc list-inside space-y-1">
												@foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
												{
													<li>@modelError.ErrorMessage</li>
												}
											</ul>
										</div>
									}
									<div class="mt-4">
										<p class="text-sm font-light text-gray-900 text-center">Already have an account?</p>
										<a asp-controller="Account" asp-action="Login"><p class="text-center mb-2 text-sm font-medium text-blue-900">Log In</p></a>
									</div>
								</div>
								<div id="secondPart" class="signup-content hidden">
									<label asp-for="UserName" id="username-address" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">Username</label>
									<div class="relative">
										<div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
											<svg class="w-6 h-6 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
												<path fill-rule="evenodd" d="M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-2 9a4 4 0 0 0-4 4v1a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1a4 4 0 0 0-4-4h-4Z" clip-rule="evenodd" />
											</svg>
										</div>
										<input asp-for="UserName" id="username-address-icon" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-2.5" placeholder="" required>
									</div>
									<label asp-for="Email" id="email-address" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">Email</label>
									<div class="relative">
										<div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
											<svg class="w-5 h-5 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
												<path d="M2.038 5.61A2.01 2.01 0 0 0 2 6v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6c0-.12-.01-.238-.03-.352l-.866.65-7.89 6.032a2 2 0 0 1-2.429 0L2.884 6.288l-.846-.677Z" />
												<path d="M20.677 4.117A1.996 1.996 0 0 0 20 4H4c-.225 0-.44.037-.642.105l.758.607L12 10.742 19.9 4.7l.777-.583Z" />
											</svg>
										</div>
										<input asp-for="Email" id="email-address-icon" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-2.5" placeholder="" required>
									</div>
									<label asp-for="Password" id="password-address" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">Password</label>
									<div class="relative">
										<div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
											<svg class="w-6 h-6 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
												<path fill-rule="evenodd" d="M8 10V7a4 4 0 1 1 8 0v3h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1Zm2-3a2 2 0 1 1 4 0v3h-4V7Zm2 6a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Z" clip-rule="evenodd" />
											</svg>
										</div>
										<input asp-for="Password" id="password-icon" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-2.5" placeholder="" required>
									</div>
									<label asp-for="ConfirmPassword" id="confirm-password" class="control-label block mt-4 mb-2 text-sm font-medium text-gray-900">Confirm Password</label>
									<div class="relative">
										<div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
											<svg class="w-6 h-6 text-gray-800" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
												<path fill-rule="evenodd" d="M8 10V7a4 4 0 1 1 8 0v3h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1Zm2-3a2 2 0 1 1 4 0v3h-4V7Zm2 6a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Z" clip-rule="evenodd" />
											</svg>
										</div>
										<input asp-for="ConfirmPassword" id="confirm-password-icon" class="form-control bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-2.5" placeholder="" required>
									</div>
								</div>
								<div class="flex justify-between">
									<button type="button" id="backBtn" class="mt-4 hidden px-4 py-2 text-gray-600 bg-gray-200 hover:bg-gray-300 rounded-lg transition-colors duration-200">
										Back
									</button>
									<button type="button" id="nextBtn" class="mt-4 ml-auto px-6 py-2 text-white bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm transition-all duration-200 transform hover:scale-105">
										Next
									</button>
									<input type="submit" value="Register" id="submitBtn" class="mt-4 hidden ml-auto px-6 py-2 text-white bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm transition-all duration-200 transform hover:scale-105" />
								</div>
							</form>
						</div>
					</div>
				</div>

				<div class="flex items-center justify-center w-full">
					<img class="w-3/4 h-3/4" src="https://ik.imagekit.io/6txj3mofs/front.png?updatedAt=1750340542946" alt="">
				</div>
			</div>
		</div>
	</div>
	@section Scripts {
		@{
			await Html.RenderPartialAsync("_ValidationScriptsPartial");
		}
	}
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/node_modules/flowbite/dist/flowbite.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
</body>
</html>