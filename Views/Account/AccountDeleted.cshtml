@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"]Account Deleted</title>
	<link rel="stylesheet" href="~/css/output.css" />
	<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
	<style>
		.page-background {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background-repeat: no-repeat;
			z-index: -1;
			background-image: url('https://ik.imagekit.io/6txj3mofs/Desktop.png?updatedAt=1758112480559');
			background-size: cover;
			background-position: center right;
		}

		@@media (max-width: 1024px) {
			.page-background {
				background-image: url('https://ik.imagekit.io/6txj3mofs/Untitled%20design%20(5).png');
				background-position: center;
			}
		}

		@@media (max-width: 640px) {
			.page-background {
				background-image: url('https://ik.imagekit.io/6txj3mofs/Untitled%20design%20(6).png');
				background-size: cover;
				background-position: center;
			}
		}
	</style>
</head>

<body class="min-h-screen flex items-center justify-center">
	<div class="page-background"></div>
	<header id="site-header" class="slide-up-init fixed inset-x-0 top-0 z-50 px-4">
		<nav class="flex items-center justify-between p-6 lg:px-8" aria-label="Global">
			<div class="flex lg:flex-1">
				<a class="-m-1.5 p-2" asp-area="" asp-controller="Home" asp-action="Index">
					<span class="sr-only">Your Company</span>
					<img class="h-20 w-auto" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(2).png?updatedAt=1749718355580" alt="">
				</a>
			</div>
		</nav>
	</header>

	<div class="relative">
		<div class="relative isolate px-6 pt-[10px] lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 items-center py-16 sm:py-24 lg:py-32 px-4">
				<div class="flex items-center justify-center w-full">
					<div class="w-1/2 flex flex-col items-center justify-center p-6 bg-white border border-gray-200 rounded-lg shadow">
						<div class="mb-5 text-center">
							<h5 class="mb-2 text-2xl font-bold text-gray-900">Account Deleted Successfully</h5>
							<p class="font-light">Your account has been deleted and you have been logged out.</p>
						</div>
						<div class="w-full flex items-center justify-center">
							<img class="w-20 h-20" src="https://ik.imagekit.io/6txj3mofs/CHECK.png?updatedAt=1754207749128" />
						</div>
						<div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-md">
							<p class="text-sm text-blue-800">
								<strong>Good news!</strong> You can recover your account within the next 30 days by simply logging in again.
							</p>
							<p class="text-xs text-blue-600 mt-2">
								After 30 days, your account will be permanently deleted and cannot be recovered.
							</p>
						</div>
						<div class="mt-5">
							<a href="@Url.Action("Index", "Home")" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
								Return to Home
							</a>
						</div>
					</div>
				</div>
				<div class="flex items-center justify-center w-full">
					<img class="w-3/4 h-3/4" src="https://ik.imagekit.io/6txj3mofs/front.png?updatedAt=1750340542946" alt="">
				</div>
			</div>
		</div>
	</div>

	@section Scripts {
		@{
			await Html.RenderPartialAsync("_ValidationScriptsPartial");
		}
	}
	<script src="~/node_modules/flowbite/dist/flowbite.min.js"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
</body>
</html>