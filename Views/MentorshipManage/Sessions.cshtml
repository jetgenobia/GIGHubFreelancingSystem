@{
    Layout = "_LayoutFreelancer";
    ViewData["Title"] = "Create Sessions";
    var matchId = (Guid)ViewBag.MatchId;
}

@model List<Freelancing.Models.Entities.MentorshipSession>
@using Freelancing.Helpers

<div class="p-4 sm:ml-64">
    <div class="pt-2 mt-20">
        <div class="mt-1">
            <div class="block w-full p-6">
                <div class="flex items-center space-x-4 mb-4">
                    <a href="javascript:history.back()" class="text-blue-600 hover:text-blue-800">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h1 class="text-3xl font-bold text-gray-900">Schedule Mentorship Session</h1>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="mt-2 flex items-center p-4 mb-4 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50" role="alert">
                        <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                        </svg>
                        <span class="sr-only">Error!</span>
                        <div>
                            @TempData["Error"]
                        </div>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="mt-2 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
                        <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                        </svg>
                        <span class="sr-only">Success</span>
                        <div>
                            @TempData["Success"]
                        </div>
                    </div>
                }

                <form asp-action="CreateSession" method="post" class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4 ml-10 mr-10" id="sessionForm">
                    <input type="hidden" name="matchId" value="@matchId" />
                    <input type="hidden" name="startUtc" id="startUtcHidden" />
                    <input type="hidden" name="timeZone" value="Asia/Manila" />

                    <div>
                        <label class="block text-sm font-medium mb-1">Start Date and Time</label>
                        @{
                            // Get current Manila time for minimum value
                            var currentManilaTime = TimeHelpers.ToPhilippineTime(DateTime.UtcNow);
                            var minDateTime = currentManilaTime.ToString("yyyy-MM-ddTHH:mm");
                        }
                        <input type="datetime-local"
                               id="startLocal"
                               class="border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5"
                               required
                               min="@minDateTime" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium mb-1">Title</label>
                        <input type="text" name="title" class="border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" maxlength="150" />
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium mb-1">Notes</label>
                        <textarea name="notes" class="border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5" rows="3" maxlength="2000"></textarea>
                    </div>
                    <div class="md:col-span-2 flex justify-end">
                        <button type="submit" class="text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center">Propose session</button>
                    </div>
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('sessionForm').addEventListener('submit', function(e) {
        const startLocalInput = document.getElementById('startLocal');
        const startUtcHidden = document.getElementById('startUtcHidden');

        if (!startLocalInput.value) {
            alert('Please select a start date and time.');
            e.preventDefault();
            return;
        }

        try {
            // Parse the datetime-local input value
            const inputValue = startLocalInput.value; // Format: "2025-10-05T08:00"

            // Create a Date object treating the input as Manila time
            // We need to manually construct the Manila time and then convert to UTC
            const [datePart, timePart] = inputValue.split('T');
            const [year, month, day] = datePart.split('-').map(Number);
            const [hours, minutes] = timePart.split(':').map(Number);

            // Create date in Manila timezone (UTC+8)
            // Manila time = UTC + 8 hours, so UTC = Manila time - 8 hours
            const manilaDateTime = new Date(year, month - 1, day, hours, minutes, 0);

            // Convert Manila time to UTC by subtracting 8 hours (480 minutes)
            const utcDateTime = new Date(manilaDateTime.getTime() - (8 * 60 * 60 * 1000));

            // Set the hidden field with UTC time
            startUtcHidden.value = utcDateTime.toISOString();

            console.log('Input (Manila time):', inputValue);
            console.log('Parsed Manila datetime:', manilaDateTime);
            console.log('Converted to UTC:', utcDateTime.toISOString());
            console.log('Expected format for DB:', utcDateTime.toISOString());

        } catch (error) {
            console.error('Error converting datetime:', error);
            alert('Invalid date/time format. Please try again.');
            e.preventDefault();
        }
    });

    // Set default to current Manila time + 1 hour for convenience
    document.addEventListener('DOMContentLoaded', function() {
        // Get current Manila time using the server-provided minimum value as base
        const minValue = document.getElementById('startLocal').getAttribute('min');
        if (minValue) {
            // Parse the minimum value and add 1 hour
            const minDate = new Date(minValue + ':00'); // Add seconds for proper parsing
            minDate.setHours(minDate.getHours() + 1);

            // Format back to datetime-local format
            const year = minDate.getFullYear();
            const month = String(minDate.getMonth() + 1).padStart(2, '0');
            const day = String(minDate.getDate()).padStart(2, '0');
            const hours = String(minDate.getHours()).padStart(2, '0');
            const minutes = String(minDate.getMinutes()).padStart(2, '0');

            const defaultValue = `${year}-${month}-${day}T${hours}:${minutes}`;
            document.getElementById('startLocal').value = defaultValue;
        }
    });
</script>