@model Freelancing.Models.MenteeEvidenceFormViewModel
@{
    Layout = "_LayoutFreelancer";
    ViewData["Title"] = "Submit Evidence";
}

<div class="p-4 sm:ml-64">
    <div class="pt-2 mt-20">
        <div class="mt-1">
            <div class="block w-full p-6">
                <div class="flex items-center space-x-4 mb-4">
                    <a href="@Url.Action("Goals", new { matchId = Model.MatchId })" class="text-blue-600 hover:text-blue-800">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>
                    <h2 class="text-2xl font-bold text-gray-900">Submit Evidence</h2>
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="mt-2 p-4 mb-4 text-sm text-red-800 border border-red-300 rounded-lg bg-red-50" role="alert">
                        <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                        </svg>
                        <span class="sr-only">Error!</span>
                        <div>
                            @TempData["Error"]
                        </div>
                    </div>
                }
                @if (TempData["Success"] != null)
                {
                    <div class="mt-2 flex items-center p-4 mb-4 text-sm text-green-800 border border-green-300 rounded-lg bg-green-50" role="alert">
                        <svg class="shrink-0 inline w-4 h-4 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 8.207-4 4a1 1 0 0 1-1.414 0l-2-2a1 1 0 0 1 1.414-1.414L9 10.586l3.293-3.293a1 1 0 0 1 1.414 1.414Z" />
                        </svg>
                        <span class="sr-only">Success</span>
                        <div>
                            @TempData["Success"]
                        </div>
                    </div>
                }

                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
                    <h3 class="text-lg font-semibold text-blue-900 mb-2">@Model.GoalName</h3>
                    <p class="text-blue-700 text-sm">@Model.GoalDescription</p>
                </div>

                <form asp-action="SubmitMenteeEvidence" method="post" enctype="multipart/form-data" class="space-y-6" id="evidence-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="MatchId" />
                    <input type="hidden" asp-for="GoalId" />
                    <input type="hidden" asp-for="GoalName" />
                    <input type="hidden" asp-for="GoalDescription" />

                    <div>
                        @if (Model.IsFullyCompleted == false)
                        {
                            <label asp-for="WhatWasDone" class="block text-sm font-medium text-gray-700 mb-2"></label>
                            <textarea asp-for="WhatWasDone" rows="6" class="form-control block w-full p-3 text-sm text-gray-900 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                                      placeholder="Describe in detail what you learned, practiced, or accomplished during this session. Include specific examples, code snippets, projects worked on, or skills demonstrated."></textarea>
                            <span asp-validation-for="WhatWasDone" class="text-red-600 text-sm"></span>
                        }
                        else
                        {
                            <label asp-for="WhatWasDone" class="block text-sm font-medium text-gray-700 mb-2"></label>
                            <textarea asp-for="WhatWasDone" readonly rows="6" class="form-control block w-full p-3 text-sm text-gray-900 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                                      placeholder="Describe in detail what you learned, practiced, or accomplished during this session. Include specific examples, code snippets, projects worked on, or skills demonstrated."></textarea>
                            <span asp-validation-for="WhatWasDone" class="text-red-600 text-sm"></span>
                        }
                    </div>

                    <div>
                        @if (Model.IsFullyCompleted == false)
                        {
                            <label asp-for="AdditionalNotes" class="block text-sm font-medium text-gray-700 mb-2"></label>
                            <textarea asp-for="AdditionalNotes" rows="4" class="form-control block w-full p-3 text-sm text-gray-900 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                                      placeholder="Any additional thoughts, questions, or reflections about this session..."></textarea>
                            <span asp-validation-for="AdditionalNotes" class="text-red-600 text-sm"></span>
                        }
                        else
                        {
                            <label asp-for="AdditionalNotes" class="block text-sm font-medium text-gray-700 mb-2"></label>
                            <textarea asp-for="AdditionalNotes" readonly rows="4" class="form-control block w-full p-3 text-sm text-gray-900 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500"
                                      placeholder="Any additional thoughts, questions, or reflections about this session..."></textarea>
                            <span asp-validation-for="AdditionalNotes" class="text-red-600 text-sm"></span>
                        }
                    </div>

                    @if (Model.IsTaskAssigned)
                    {
                        <div class="bg-orange-50 border border-orange-200 rounded-lg p-4 mb-6">
                            <h3 class="text-lg font-semibold text-orange-800 mb-2">@Model.MentorTaskTitle</h3>
                            <p class="text-orange-500 text-sm">@Model.MentorTaskDescription</p>
                        </div>

                        <div class="grid gap-4 mb-4 grid-cols-2">
                            <div class="col-span-2 sm:col-span-1">
                                <label for="dropzone-file" class="block mb-2 text-sm font-medium text-gray-900">Upload Works</label>
                                <div class="flex items-center bg-white justify-center w-full h-64 mt-3">
                                    <label for="dropzone-file" class="flex flex-col items-center justify-center w-full h-64 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer hover:bg-gray-100 transition-colors duration-200">
                                        <div class="flex flex-col items-center justify-center pt-5 pb-6" id="upload-placeholder">
                                            @if (Model.IsFullyCompleted)
                                            {
                                                <p class="text-xs text-gray-500 text-center">This goal is completed.</p>
                                            }
                                            else
                                            {
                                                <svg class="w-8 h-8 mb-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 16">
                                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 13h3a3 3 0 0 0 0-6h-.025A5.56 5.56 0 0 0 16 6.5 5.5 5.5 0 0 0 5.207 5.021C5.137 5.017 5.071 5 5 5a4 4 0 0 0 0 8h2.167M10 15V6m0 0L8 8m2-2 2 2" />
                                                </svg>
                                                <p class="mb-2 text-sm text-gray-500"><span class="font-semibold">Click to upload</span> or drag and drop</p>
                                                <p class="text-xs text-gray-500 text-center">Screenshots, documents, or other files up to 10MB each</p>
                                            }
                                        </div>
                                        <div class="hidden" id="upload-progress">
                                            <div class="w-full max-w-md">
                                                <div class="mb-4">
                                                    <div class="flex justify-between text-sm text-gray-600 mb-1">
                                                        <span id="upload-status">Processing...</span>
                                                    </div>
                                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                                        <div id="progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <input asp-for="EvidenceFiles"
                                               id="dropzone-file"
                                               type="file"
                                               class="hidden"
                                               accept=".jpg,.jpeg,.png,.gif,.pdf,.doc,.docx,.txt"
                                               multiple
                                               disabled="@(Model.IsFullyCompleted ? "disabled" : null)" />
                                    </label>
                                </div>
                                @if (!ViewData.ModelState.IsValid && ViewData.ModelState["EvidenceFiles"]?.Errors.Count > 0)
                                {
                                    <div class="mt-2 text-sm text-red-600">
                                        @ViewData.ModelState["EvidenceFiles"].Errors.First().ErrorMessage
                                    </div>
                                }
                            </div>
                            <div class="col-span-2 sm:col-span-1">
                                <label for="uploaded-files" class="block mb-2 text-sm font-medium text-gray-900 mt-1">Uploaded Files</label>
                                <div id="uploaded-files-container" class="h-64 p-3 rounded-lg border border-gray-200 bg-white overflow-y-auto">
                                    <div class="flex items-center justify-center text-gray-500 py-8" id="no-files-message" style="display:@((Model.ExistingEvidenceFilePaths != null && Model.ExistingEvidenceFilePaths.Any()) ? "none" : "flex")">
                                        <p>No files uploaded yet.</p>
                                    </div>

                                    @* Server-rendered existing files (kept as retained by default) *@
                                    <div id="existing-files-list">
                                        @if (Model.ExistingEvidenceFilePaths != null && Model.ExistingEvidenceFilePaths.Any())
                                        {
                                            foreach (var fileUrl in Model.ExistingEvidenceFilePaths)
                                            {

                                                // Extract display name from the Google Cloud Storage URL
                                                var fileName = System.IO.Path.GetFileName(fileUrl);
                                                var displayName = fileName;

                                                // Try to extract original filename from the pattern: originalname_timestamp_guid.ext
                                                var match = System.Text.RegularExpressions.Regex.Match(fileName, @"^(.+?)_\d+_[a-fA-F0-9]{8}(\.[^.]+)$");
                                                if (match.Success)
                                                {
                                                    // Reconstruct the original filename: name + extension
                                                    displayName = match.Groups[1].Value + match.Groups[2].Value;
                                                }
                                                else
                                                {
                                                    // Fallback: try simpler pattern or use filename as-is
                                                    displayName = System.Text.RegularExpressions.Regex.Replace(fileName, @"_\d+_[a-fA-F0-9]{8}(?=\.[^.]+$)", "");
                                                }

                                                <div class="flex items-center justify-between p-2 bg-gray-50 rounded border border-gray-300 mb-2 existing-file-item" data-path="@fileUrl">
                                                    <div class="flex items-center space-x-2 min-w-0 flex-1">
                                                        @if (fileUrl.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || fileUrl.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || fileUrl.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || fileUrl.EndsWith(".gif", StringComparison.OrdinalIgnoreCase))
                                                        {
                                                            <img src="@fileUrl" class="w-8 h-8 object-cover rounded" />
                                                        }
                                                        else
                                                        {
                                                            <div class="w-8 h-8 bg-blue-100 rounded flex items-center justify-center text-xs">
                                                                @{
                                                                    var extension = System.IO.Path.GetExtension(fileUrl).TrimStart('.').ToUpper();
                                                                    if (string.IsNullOrEmpty(extension)) extension = "FILE";
                                                                }
                                                                @extension
                                                            </div>
                                                        }
                                                        <div class="flex-1 min-w-0">
                                                            <a href="@fileUrl" target="_blank" class="text-sm text-gray-700 block truncate max-w-[120px] sm:max-w-[200px] md:max-w-none hover:text-blue-600" title="@displayName">@displayName</a>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center space-x-2">
                                                        @* Store the full Google Cloud URL so server sees same identifier on postbacks *@
                                                        <input type="hidden" name="RetainedEvidenceFilePaths" value="@fileUrl" />
                                                        @if (!Model.IsFullyCompleted)
                                                        {
                                                            <button type="button" class="text-red-500 flex-shrink-0 ml-2 hover:text-red-700" onclick="removeExistingEvidence('@fileUrl')">✕</button>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>

                                    @* Container for new client-side selected files *@
                                    <div id="new-files-list"></div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {

                    }

                    @if (Model.IsFullyCompleted)
                    {

                    }
                    else
                    {
                        <div class="flex items-center justify-end space-x-4">
                            <a href="@Url.Action("Goals", new { matchId = Model.MatchId })"
                               class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-200 border border-gray-300 rounded-md hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500">
                                Cancel
                            </a>
                            <button type="submit" id="submit-btn"
                                    class="px-6 py-2 text-sm font-medium text-white bg-blue-600 border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
                                Submit Notes
                            </button>
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                const fileInput = document.getElementById('dropzone-file');
                const dropzoneLabel = document.querySelector('label[for="dropzone-file"]');
                const uploadPlaceholder = document.getElementById('upload-placeholder');
                const uploadProgress = document.getElementById('upload-progress');
                const uploadStatus = document.getElementById('upload-status');
                const progressBar = document.getElementById('progress-bar');
                const uploadedFilesContainer = document.getElementById('uploaded-files-container');
                const existingFilesList = document.getElementById('existing-files-list');
                const newFilesList = document.getElementById('new-files-list');
                const noFilesMessage = document.getElementById('no-files-message');
                const submitBtn = document.getElementById('submit-btn');
                const form = document.getElementById('evidence-form');

                if (!form) {
                    console.error('Evidence form element not found');
                    return;
                }

                form.addEventListener('submit', function () {
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Submitting...';
                });

                // If file input is not present we still want existing files UI to work (so do not return early)
                if (!fileInput) {
                    console.warn('dropzone-file input not found — upload UI will be disabled');
                } else {
                    // If uploads are disabled by server (completed goal) do not attach drag/drop handlers
                    if (fileInput.disabled) {
                        console.log('Uploads are disabled for this completed goal');
                        if (dropzoneLabel) dropzoneLabel.classList.add('opacity-60', 'pointer-events-none');
                    } else {
                        // attach change / drag-drop handlers only when input is available and enabled
                        let selectedFiles = [];

                        fileInput.addEventListener('change', function (e) {
                            const files = Array.from(e.target.files || []);
                            if (files.length > 0) processFiles(files);
                        });

                        if (dropzoneLabel) {
                            dropzoneLabel.addEventListener('dragover', function (e) {
                                e.preventDefault();
                                this.classList.add('border-blue-500', 'bg-blue-50');
                            });
                            dropzoneLabel.addEventListener('dragleave', function (e) {
                                e.preventDefault();
                                this.classList.remove('border-blue-500', 'bg-blue-50');
                            });
                            dropzoneLabel.addEventListener('drop', function (e) {
                                e.preventDefault();
                                this.classList.remove('border-blue-500', 'bg-blue-50');
                                const files = Array.from(e.dataTransfer.files || []);
                                if (files.length > 0) {
                                    const dataTransfer = new DataTransfer();
                                    files.forEach(file => dataTransfer.items.add(file));
                                    fileInput.files = dataTransfer.files;
                                    processFiles(files);
                                }
                            });
                        }

                        // processFiles, updateNewFilesDisplay etc. (reuse existing implementations)
                        function processFiles(files) {
                            uploadPlaceholder?.classList.add('hidden');
                            uploadProgress?.classList.remove('hidden');

                            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'application/pdf',
                                'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'text/plain'];

                            const validFiles = files.filter(f => allowedTypes.includes(f.type) && f.size <= 10 * 1024 * 1024);
                            if (validFiles.length === 0) {
                                uploadProgress?.classList.add('hidden');
                                uploadPlaceholder?.classList.remove('hidden');
                                alert('No valid files selected.');
                                return;
                            }

                            let processed = 0;
                            validFiles.forEach((file, idx) => {
                                setTimeout(() => {
                                    selectedFiles.push({
                                        file: file,
                                        name: file.name,
                                        size: file.size,
                                        preview: file.type.startsWith('image/') ? URL.createObjectURL(file) : null
                                    });
                                    processed++;
                                    const pct = Math.round((processed / validFiles.length) * 100);
                                    if (progressBar) progressBar.style.width = pct + '%';
                                    if (uploadStatus) uploadStatus.textContent = `Processing ${processed} of ${validFiles.length}`;
                                    if (processed === validFiles.length) {
                                        updateNewFilesDisplay();
                                        setTimeout(() => {
                                            uploadProgress?.classList.add('hidden');
                                            uploadPlaceholder?.classList.remove('hidden');
                                        }, 700);
                                    }
                                }, idx * 150);
                            });

                            function updateNewFilesDisplay() {
                                if (!newFilesList) return;
                                if (selectedFiles.length === 0) {
                                    newFilesList.innerHTML = '';
                                } else {
                                    newFilesList.innerHTML = selectedFiles.map((f, i) => `
                                        <div class="flex items-center justify-between p-2 bg-gray-50 rounded border border-gray-300 mb-2 new-file-item" data-index="${i}">
                                            <div class="flex items-center space-x-2 min-w-0 flex-1">
                                                ${f.preview ? `<img src="${f.preview}" class="w-8 h-8 object-cover rounded flex-shrink-0">` : `<div class="w-8 h-8 bg-blue-100 rounded flex items-center justify-center flex-shrink-0">📄</div>`}
                                                <div class="flex-1 min-w-0">
                                                    <span class="text-sm text-gray-700 block truncate max-w-[120px] sm:max-w-[200px] md:max-w-none" title="${f.name}">${f.name}</span>
                                                    <div class="text-xs text-gray-500">${(f.size/1024).toFixed(1)} KB</div>
                                                </div>
                                            </div>
                                            <button type="button" class="text-red-500 flex-shrink-0 ml-2 hover:text-red-700" onclick="removeNewEvidenceFile(${i})">
                                                ✕
                                            </button>
                                        </div>
                                    `).join('');
                                }

                                const existingCount = existingFilesList ? existingFilesList.querySelectorAll('.existing-file-item').length : 0;
                                const newCount = selectedFiles.length;
                                if (noFilesMessage) noFilesMessage.style.display = (existingCount + newCount) === 0 ? 'flex' : 'none';

                                const dt = new DataTransfer();
                                selectedFiles.forEach(sd => dt.items.add(sd.file));
                                if (fileInput) fileInput.files = dt.files;
                            }

                            window.removeNewEvidenceFile = function (index) {
                                try {
                                    if (selectedFiles[index] && selectedFiles[index].preview) URL.revokeObjectURL(selectedFiles[index].preview);
                                    selectedFiles.splice(index, 1);
                                    updateNewFilesDisplay();
                                } catch (ex) {
                                    console.error('removeNewEvidenceFile error', ex);
                                }
                            };
                        }
                    }
                }

                // removeExistingEvidence should work even if file input is disabled; keep it global
                window.removeExistingEvidence = function (path) {
                    try {
                        // Escape path for querySelector to handle special characters and URLs
                        const escapedPath = path.replace(/[\\(){}[\]^$+*?.\-|]/g, '\\$&');
                        const selector = `.existing-file-item[data-path="${escapedPath}"]`;
                        const item = document.querySelector(selector);
                        if (item) item.remove();

                        // Remove the hidden input with the same URL value
                        const inputs = document.querySelectorAll('input[name="RetainedEvidenceFilePaths"]');
                        inputs.forEach(input => {
                            if (input.value === path) {
                                input.remove();
                            }
                        });

                        const existingCount = existingFilesList ? existingFilesList.querySelectorAll('.existing-file-item').length : 0;
                        const newCount = (typeof selectedFiles !== 'undefined') ? selectedFiles.length : 0;
                        if (noFilesMessage) noFilesMessage.style.display = (existingCount + newCount) === 0 ? 'flex' : 'none';
                    } catch (ex) {
                        console.error('removeExistingEvidence error', ex);
                    }
                };

            } catch (err) {
                console.error('SubmitMenteeEvidence script error:', err);
            }
        });
    </script>
}