@model IEnumerable<Freelancing.Controllers.Admin.VerificationAdminViewModel>
@{
    Layout = null;
    ViewData["Title"] = "Manage Verification";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/output.css" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <nav class="fixed top-0 z-50 w-full bg-white border-b border-gray-200">
        <div class="px-3 py-3 lg:px-5 lg:pl-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center justify-start rtl:justify-end">
                    <button data-drawer-target="logo-sidebar" data-drawer-toggle="logo-sidebar" aria-controls="logo-sidebar" type="button" class="inline-flex items-center p-2 text-sm text-gray-500 rounded-lg sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200">
                        <span class="sr-only">Open sidebar</span>
                        <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"></path>
                        </svg>
                    </button>
                    <div class="-m-1.5 p-1.5 ms-5">
                        <span class="sr-only">Your Company</span>
                        <img class="h-16 w-auto" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(2).png?updatedAt=1749718355580" alt="">
                    </div>
                </div>
                <div class="flex items-center me-5">
                    <div>
                        <button type="button" class="flex text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300" aria-expanded="false" data-dropdown-toggle="dropdown-user">
                            <span class="sr-only">Open user menu</span>
                            @if (!string.IsNullOrEmpty(@User.FindFirst("Photo")?.Value))
                            {
                                <img class="w-8 h-8 rounded-full" src="@User.FindFirst("Photo")?.Value" alt="user photo">
                            }
                            else
                            {
                                <img class="w-8 h-8 rounded-full" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497" alt="user photo">
                            }
                        </button>
                    </div>
                    <div class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded-sm shadow-sm" id="dropdown-user">
                        <div class="px-4 py-3" role="none">
                            <p class="text-sm text-gray-900" role="none">
                                @User.FindFirst("FullName")?.Value
                            </p>
                            <p class="text-sm font-medium text-gray-900 truncate" role="none">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                            </p>
                        </div>
                        <ul class="py-1" role="none">
                            <li>
                                <a asp-controller="Account" asp-action="LogOut" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" role="menuitem">Sign out</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <aside id="logo-sidebar" class="fixed top-0 left-0 z-40 w-64 h-screen pt-28 transition-transform -translate-x-full bg-white border-r border-gray-200 sm:translate-x-0" aria-label="Sidebar">
        <div class="ms-2 h-full px-3 pb-4 overflow-y-auto bg-white flex flex-col">
            <ul class="space-y-2 font-medium flex-1">
                <li>
                    <a class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group" asp-area="" asp-controller="Admin" asp-action="IdentityVerification">
                        <svg fill="#000000" viewBox="0 0 24 24" id="dashboard-alt" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="shrink-0 w-6 h-6 text-gray-500 transition duration-75 group-hover:text-gray-900">
                            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                            <g id="SVGRepo_iconCarrier">
                                <path id="primary" d="M2,8V4A2,2,0,0,1,4,2H20a2,2,0,0,1,2,2V8Zm14,2V22h4a2,2,0,0,0,2-2V10Z" style="fill: #000000;"></path>
                                <path id="secondary" d="M14,10H2V20a2,2,0,0,0,2,2H14Z" style="fill: #2ca9bc;"></path>
                            </g>
                        </svg>
                        <span class="ms-3 whitespace-nowrap font-light">Verification</span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>

    <div class="p-4 sm:ml-64">
        <div class="p-4 mt-20">
            <div class="mt-4">
                <div class="block w-full p-6">
                    <h2 class="mb-4 text-2xl font-bold text-gray-900">Manage Verification</h2>

                    <form id="antiforgery-form" style="display:none">
                        @Html.AntiForgeryToken()
                    </form>

                    <div class="shadow rounded-md overflow-hidden bg-white">
                        <div class="px-4 py-3 border-b">
                            <strong>Pending Verifications (@Model?.Count() ?? 0)</strong>
                        </div>

                        <div class="p-4">
                            @if (Model == null || !Model.Any())
                            {
                                <div class="text-center text-gray-600">No pending verifications.</div>
                            }
                            else
                            {
                                <div class="overflow-x-auto">
                                    <table class="w-full text-left text-sm">
                                        <thead>
                                            <tr class="bg-gray-100">
                                                <th class="px-3 py-2">User</th>
                                                <th class="px-3 py-2">Email</th>
                                                <th class="px-3 py-2">Submitted</th>
                                                <th class="px-3 py-2">ID Doc</th>
                                                <th class="px-3 py-2">Face</th>
                                                <th class="px-3 py-2">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody id="verification-list">
                                            @foreach (var item in Model)
                                            {
                                                <tr id="row-@item.Id" class="border-t">
                                                    <td class="px-3 py-2">@item.FullName<br /><small class="text-xs text-gray-500">UserId: @item.UserId</small></td>
                                                    <td class="px-3 py-2">@item.Email</td>
                                                    <td class="px-3 py-2">@item.CreatedAt?.ToLocalTime().ToString("g")</td>
                                                    <td class="px-3 py-2">
                                                        <div class="flex items-center gap-2">
                                                            @if (item.IdDocumentVerified == true)
                                                            {
                                                                <span class="text-green-700 font-semibold">OK (@(item.IdDocumentConfidence ?? 0)%)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-yellow-700 font-semibold">Pending / review</span>
                                                            }
                                                            <a class="text-xs text-blue-600 hover:underline" target="_blank" href="@Url.Action("ViewDocument", "Admin", new { id = item.Id })">View document</a>
                                                        </div>
                                                    </td>
                                                    <td class="px-3 py-2">
                                                        <div class="flex items-center gap-2">
                                                            @if (item.FaceVerified == true)
                                                            {
                                                                <span class="text-green-700 font-semibold">OK (@(item.FaceConfidence ?? 0)%)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-yellow-700 font-semibold">Pending / review</span>
                                                            }
                                                            <a class="text-xs text-blue-600 hover:underline" target="_blank" href="@Url.Action("ViewFace", "Admin", new { id = item.Id })">View face</a>
                                                        </div>
                                                    </td>
                                                    <td class="px-3 py-2">
                                                        <button data-id="@item.Id" class="approve-btn inline-flex items-center px-3 py-1 bg-green-600 text-white rounded text-sm me-2">Approve</button>
                                                        <button data-id="@item.Id" class="reject-btn inline-flex items-center px-3 py-1 bg-red-600 text-white rounded text-sm">Reject</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <script>
        function getAntiForgeryToken() {
            const input = document.querySelector('#antiforgery-form input[name="__RequestVerificationToken"]');
            return input ? input.value : '';
        }

        async function postJson(url, data) {
            const token = getAntiForgeryToken();
            const resp = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(data)
            });
            return resp.json();
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.approve-btn').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const id = btn.getAttribute('data-id');
                    if (!confirm('Approve this verification?')) return;

                    const result = await postJson('@Url.Action("Approve","Admin")', { id: id });
                    if (result && result.success) {
                        const row = document.getElementById('row-' + id);
                        if (row) row.remove();
                        alert(result.message || 'Approved');
                    } else {
                        alert(result?.message || 'Failed to approve');
                    }
                });
            });

            document.querySelectorAll('.reject-btn').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const id = btn.getAttribute('data-id');
                    const reason = prompt('Enter rejection reason (optional):');
                    if (reason === null) return;

                    const result = await postJson('@Url.Action("Reject","Admin")', { id: id, reason: reason });
                    if (result && result.success) {
                        const row = document.getElementById('row-' + id);
                        if (row) row.remove();
                        alert(result.message || 'Rejected');
                    } else {
                        alert(result?.message || 'Failed to reject');
                    }
                });
            });
        });
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
</body>
</html>
