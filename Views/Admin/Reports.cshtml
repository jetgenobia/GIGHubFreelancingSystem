@model IEnumerable<Freelancing.Controllers.Admin.VerificationAdminViewModel>
@{
    Layout = null;
    ViewData["Title"] = "Manage Verification";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/output.css" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
    <nav class="fixed top-0 z-50 w-full bg-white border-b border-gray-200">
        <div class="px-3 py-3 lg:px-5 lg:pl-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center justify-start rtl:justify-end">
                    <button data-drawer-target="logo-sidebar" data-drawer-toggle="logo-sidebar" aria-controls="logo-sidebar" type="button" class="inline-flex items-center p-2 text-sm text-gray-500 rounded-lg sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200">
                        <span class="sr-only">Open sidebar</span>
                        <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"></path>
                        </svg>
                    </button>
                    <div class="-m-1.5 p-1.5 ms-5">
                        <span class="sr-only">Your Company</span>
                        <img class="h-16 w-auto" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(2).png?updatedAt=1749718355580" alt="">
                    </div>
                </div>
                <div class="flex items-center me-5">
                    <div>
                        <button type="button" class="flex text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300" aria-expanded="false" data-dropdown-toggle="dropdown-user">
                            <span class="sr-only">Open user menu</span>
                            @if (!string.IsNullOrEmpty(@User.FindFirst("Photo")?.Value))
                            {
                                <img class="w-8 h-8 rounded-full" src="@User.FindFirst("Photo")?.Value" alt="user photo">
                            }
                            else
                            {
                                <img class="w-8 h-8 rounded-full" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497" alt="user photo">
                            }
                        </button>
                    </div>
                    <div class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded-sm shadow-sm" id="dropdown-user">
                        <div class="px-4 py-3" role="none">
                            <p class="text-sm text-gray-900" role="none">
                                @User.FindFirst("FullName")?.Value
                            </p>
                            <p class="text-sm font-medium text-gray-900 truncate" role="none">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                            </p>
                        </div>
                        <ul class="py-1" role="none">
                            <li>
                                <a asp-controller="Account" asp-action="LogOut" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" role="menuitem">Sign out</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <aside id="logo-sidebar" class="fixed top-0 left-0 z-40 w-64 h-screen pt-28 transition-transform -translate-x-full bg-white border-r border-gray-200 sm:translate-x-0" aria-label="Sidebar">
        <div class="ms-2 h-full px-3 pb-4 overflow-y-auto bg-white flex flex-col">
            <ul class="space-y-2 font-medium flex-1">
                <li>
                    <a class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group" asp-area="" asp-controller="Admin" asp-action="IdentityVerification">
                        <svg fill="#000000" viewBox="0 0 24 24" id="dashboard-alt" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="shrink-0 w-6 h-6 text-gray-500 transition duration-75 group-hover:text-gray-900">
                            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                            <g id="SVGRepo_iconCarrier">
                                <path id="primary" d="M2,8V4A2,2,0,0,1,4,2H20a2,2,0,0,1,2,2V8Zm14,2V22h4a2,2,0,0,0,2-2V10Z" style="fill: #000000;"></path>
                                <path id="secondary" d="M14,10H2V20a2,2,0,0,0,2,2H14Z" style="fill: #2ca9bc;"></path>
                            </g>
                        </svg>
                        <span class="ms-3 whitespace-nowrap font-light">Manage</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group" asp-area="" asp-controller="Admin" asp-action="Reports">
                        <svg fill="#000000" viewBox="0 0 24 24" id="dashboard-alt" data-name="Flat Color" xmlns="http://www.w3.org/2000/svg" class="shrink-0 w-6 h-6 text-gray-500 transition duration-75 group-hover:text-gray-900">
                            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                            <g id="SVGRepo_iconCarrier"><title style="stroke-width: 2;">chart column grow</title><path id="tertiary-fill" d="M6,21H3V17H6Zm8-6H11v6h3Zm8-4H19V21h3Z" style="fill: #b7b7b7; stroke-width: 2;"></path><path id="primary-stroke" d="M6,21H3V17H6Zm8-6H11v6h3Zm8-4H19V21h3Z" style="fill: none; stroke: #000000; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;"></path><path id="secondary-stroke" d="M20,3c-4,7-13,9-17,9M21,7,20,3H16" style="fill: none; stroke: #2ca9bc; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;"></path></g>
                        </svg>
                        <span class="ms-3 whitespace-nowrap font-light">Report</span>
                    </a>
                </li>
            </ul>
            <div class="mt-auto ms-1">
                <div class="flex inline-flex items-center justify-center">
                    <div class="flex text-sm bg-gray-800 rounded-full focus:ring-4 focus:ring-gray-300 mr-3">
                        <img class="w-10 h-10 rounded-full" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(11).png?updatedAt=1750552804497" alt="user photo">
                    </div>
                    <div>
                        <p class="text-sm text-gray-900 font-bold" role="none">
                            GIGHub
                        </p>
                        <p class="text-sm text-gray-900 text-xs" role="none">
                            Admin
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    <div class="p-4 sm:ml-64">
        <div class="p-4 mt-20">
            <div class="mt-4">
                <div class="block w-full p-6">
                    <h2 class="text-2xl font-bold text-gray-900">Reports</h2>
                    <p class="mb-4 text-sm italic font-light">Select Report Range</p>
                    @await Html.PartialAsync("_ReportButtons")
                </div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <!-- Approve Modal -->
            <div id="approveModal_@item.Id" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
                <div class="modal-backdrop absolute inset-0 bg-opacity-50 bg-opacity-50"></div>
                <div class="relative p-4 w-full max-w-md max-h-full">
                    <div class="relative bg-white rounded-lg shadow">
                        <button type="button" class="absolute top-3 end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="approveModal_@item.Id">
                            <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
                            </svg>
                            <span class="sr-only">Close modal</span>
                        </button>
                        <div class="p-6 text-center">
                            <svg class="mx-auto mb-4 text-green-500 w-12 h-12" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            <h3 class="mb-5 text-lg font-normal text-gray-800">Approve @item.FullName's verification?</h3>

                            <div class="mb-5 text-left">
                                <div class="bg-green-50 rounded-md p-4 mb-4">
                                    <div class="flex items-start">
                                        <svg class="sw-5 h-5 text-green-800 mt-0.5 mr-3" " aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                                        </svg>
                                        <div>
                                            <h4 class="text-sm font-medium text-green-800 mb-1">Verification Approval</h4>
                                            <p class="text-sm text-green-700">By approving this verification, you confirm that:</p>
                                            <ul class="mt-2 text-sm text-green-700 list-disc list-inside space-y-1">
                                                <li>The ID document is clear and readable</li>
                                                <li>The name matches the registered account</li>
                                                <li>The selfie matches the ID document photo</li>
                                                <li>All required information is present and valid</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="flex justify-center space-x-3">
                                <button type="button"
                                        onclick="submitApproval('@item.Id')"
                                        id="approveBtn_@item.Id"
                                        class="text-white bg-green-600 hover:bg-green-800 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center transition-all duration-200">
                                    <svg class="w-4 h-4 me-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 12">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5.917 5.724 10.5 15 1.5" />
                                    </svg>
                                    Approve Verification
                                </button>
                                <button type="button"
                                        data-modal-hide="approveModal_@item.Id"
                                        id="cancelApproveBtn_@item.Id"
                                        class="text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900 focus:z-10 transition-all duration-200">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reject Modal -->
            <div id="rejectModal_@item.Id" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
                <div class="modal-backdrop absolute inset-0 bg-opacity-50 bg-opacity-50"></div>
                <div class="relative p-4 w-full max-w-md max-h-full">
                    <div class="relative bg-white rounded-lg shadow">
                        <button type="button" class="absolute top-3 end-2.5 text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center" data-modal-hide="rejectModal_@item.Id">
                            <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
                            </svg>
                            <span class="sr-only">Close modal</span>
                        </button>
                        <div class="p-6 text-center">
                            <svg class="mx-auto mb-4 text-red-500 w-12 h-12" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V6m0 8h.01M19 10a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            <h3 class="mb-5 text-lg font-normal text-gray-800">Select rejection reason for @item.FullName's verification</h3>

                            <div class="mb-5 text-left">
                                <label class="block text-sm font-medium text-gray-700 mb-3">Reasons for rejection (select all that apply):</label>
                                <div class="space-y-2">
                                    <label class="flex items-center">
                                        <input type="checkbox" name="rejection_reason_@item.Id" value="Document quality is poor or unreadable" class="mr-2 text-red-600 focus:ring-red-500 rounded">
                                        <span class="text-sm text-gray-700">Document quality is poor or unreadable</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="checkbox" name="rejection_reason_@item.Id" value="Registered name doesn't match with the ID" class="mr-2 text-red-600 focus:ring-red-500 rounded">
                                        <span class="text-sm text-gray-700">Registered name doesn't match with the ID</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="checkbox" name="rejection_reason_@item.Id" value="Selfie does not match the ID document" class="mr-2 text-red-600 focus:ring-red-500 rounded">
                                        <span class="text-sm text-gray-700">Selfie does not match the ID document</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="checkbox" name="rejection_reason_@item.Id" value="ID document has expired" class="mr-2 text-red-600 focus:ring-red-500 rounded">
                                        <span class="text-sm text-gray-700">ID document has expired</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="checkbox" name="rejection_reason_@item.Id" value="Missing required information on document" class="mr-2 text-red-600 focus:ring-red-500 rounded">
                                        <span class="text-sm text-gray-700">Missing required information on document</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="checkbox" name="rejection_reason_@item.Id" value="Document appears to be fake or tampered" class="mr-2 text-red-600 focus:ring-red-500 rounded">
                                        <span class="text-sm text-gray-700">Document appears to be fake or tampered</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="checkbox" name="rejection_reason_@item.Id" value="Unsupported document type" class="mr-2 text-red-600 focus:ring-red-500 rounded">
                                        <span class="text-sm text-gray-700">Unsupported document type</span>
                                    </label>
                                    <label class="flex items-center">
                                        <input type="checkbox" id="other_reason_@item.Id" name="rejection_reason_@item.Id" value="Other" class="mr-2 text-red-600 focus:ring-red-500 rounded">
                                        <span class="text-sm text-gray-700">Other (specify below)</span>
                                    </label>
                                </div>

                                <div class="mt-4">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">Additional comments (optional):</label>
                                    <textarea id="additional_comments_@item.Id"
                                      class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
                                      rows="3"
                                      placeholder="Provide additional details or specify 'Other' reason..."></textarea>
                                </div>
                            </div>

                            <div class="flex justify-center space-x-3">
                                <button type="button"
                                        onclick="submitRejection('@item.Id')"
                                        id="rejectBtn_@item.Id"
                                        class="text-white bg-red-600 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm inline-flex items-center px-5 py-2.5 text-center transition-all duration-200">
                                    Reject Verification
                                </button>
                                <button type="button"
                                        data-modal-hide="rejectModal_@item.Id"
                                        id="cancelBtn_@item.Id"
                                        class="text-gray-500 bg-white hover:bg-gray-100 focus:ring-4 focus:outline-none focus:ring-gray-200 rounded-lg border border-gray-200 text-sm font-medium px-5 py-2.5 hover:text-gray-900 focus:z-10 transition-all duration-200">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
</body>
</html>