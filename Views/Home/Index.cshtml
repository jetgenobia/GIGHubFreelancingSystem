@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]GIGHub</title>
    <link rel="stylesheet" href="~/css/output.css" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <style>
        .page-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-repeat: no-repeat;
            z-index: -1;
            background-image: url('https://ik.imagekit.io/6txj3mofs/Desktop.png?updatedAt=1758112480559');
            background-size: cover;
            background-position: center right;
        }

        @@media (max-width: 1024px) {
            .page-background {
                background-image: url('https://ik.imagekit.io/6txj3mofs/Untitled%20design%20(5).png');
                background-position: center;
            }
        }

        @@media (max-width: 640px) {
            .page-background {
                background-image: url('https://ik.imagekit.io/6txj3mofs/Untitled%20design%20(6).png');
                background-size: cover;
                background-position: center;
            }
        }

        /* Responsive navigation controls */
        @@media (min-width: 1024px) {
            .mobile-menu-btn {
                display: none !important;
            }

            .desktop-nav {
                display: block !important;
            }

            #mobileMenu {
                display: none !important;
            }
        }

        @@media (max-width: 1023px) {
            .mobile-menu-btn {
                display: flex !important;
            }

            .desktop-nav {
                display: none !important;
            }
        }

        /* Mobile menu positioning */
        #mobileMenu {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 50;
        }

        :root {
            --letter-duration: 490ms;
            --letter-ease: cubic-bezier(.2,.8,.2,1);
            --slide-duration: 420ms;
            --slide-ease: cubic-bezier(.2,.8,.2,1);
            --slide-offset: 18px;
        }

        h1 .inline-flex > .inline-block {
            opacity: 0;
            transform: translateY(12px);
            will-change: opacity, transform;
        }

            h1 .inline-flex > .inline-block.animate {
                animation: letterIn var(--letter-duration) var(--letter-ease) both;
            }

        @@keyframes letterIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .slide-up-init {
            opacity: 0;
            transform: translateY(var(--slide-offset));
            will-change: opacity, transform;
        }

            .slide-up-init.animate {
                animation: slideUp var(--slide-duration) var(--slide-ease) both;
            }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(var(--slide-offset));
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-delay {
            opacity: 0;
            transform: translateY(8px);
            will-change: opacity, transform;
            animation: fadeUp 420ms cubic-bezier(.2,.8,.2,1) both;
            animation-delay: 0.7s;
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>

<body class="min-h-screen">
    <div class="page-background"></div>
    <header id="site-header" class="slide-up-init relative z-50 w-full px-4">
        <nav class="relative flex items-center justify-between p-6 lg:px-8" aria-label="Global">
            <div class="flex lg:flex-1">
                <a class="-m-1.5 p-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="sr-only">Your Company</span>
                    <img class="h-20 w-auto" src="https://ik.imagekit.io/6txj3mofs/GIGHub%20(2).png?updatedAt=1749718355580" alt="">
                </a>
            </div>

            <button id="openMenuBtn" type="button" class="mobile-menu-btn inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200" aria-controls="mobile-menu" aria-expanded="false">
                <span class="sr-only">Open main menu</span>
                <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15" />
                </svg>
            </button>

            <div class="desktop-nav">
                @if (Context.User.Identity.Name != null)
                {
                    <div class="lg:flex lg:flex-1 lg:justify-end">
                        <a asp-controller="Client" asp-action="Dashboard" class="text-gray-900 focus:ring-4 focus:outline-none focus:ring-gray-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2">Dashboard</a>
                    </div>
                }
                else
                {
                    <div class="me-4 lg:flex lg:flex-1 lg:justify-end">
                        <a asp-controller="Account" asp-action="Login" class="border border-gray-300 bg-gray-100 hover:bg-gray-200 focus:outline-none focus:ring-4 focus:ring-gray-200 font-medium rounded-lg text-sm px-4 py-1.5 me-2 mb-2">Log in</a>
                        <a asp-controller="Account" asp-action="Registration" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-1.5 me-2 mb-2">Sign Up</a>
                    </div>
                }
            </div>

            <div id="mobileMenu" class="hidden fixed inset-0 z-[60] md:hidden">
                <div id="menuBackdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>

                <div class="relative mx-4 mt-24 rounded-lg border border-gray-200 bg-white shadow-lg p-4 space-y-3">
                    <div class="flex justify-end">
                        <button id="closeMenuBtn" type="button"
                                class="inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100">
                            <span class="sr-only">Close menu</span>
                            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    @if (Context.User.Identity.Name != null)
                    {
                        <a asp-controller="Client" asp-action="Dashboard"
                           class="block px-4 py-3 rounded-md text-base font-medium text-gray-900 bg-gray-100 hover:bg-gray-200 text-center">Dashboard</a>
                        <a asp-controller="Account" asp-action="LogOut"
                           class="block px-4 py-3 rounded-md text-base font-medium text-gray-900 bg-gray-100 hover:bg-gray-200 text-center">Sign Out</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="block px-4 py-3 rounded-md text-base font-medium text-gray-900 bg-gray-100 hover:bg-gray-200 text-center">Login</a>
                        <a asp-controller="Account" asp-action="Registration"
                           class="block px-4 py-3 rounded-md text-base font-medium text-center text-white bg-blue-700 hover:bg-blue-800">Sign Up</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="lg:pt-5">
        <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-12">
            <div class="grid gap-8 mb-4 grid-cols-2">
                <div class="col-span-2 sm:col-span-1">
                    <h1 class="tracking-tight sm:tracking-tighter text-[32px] sm:text-[72px] leading-[28px] sm:leading-[64px] max-w-4xl font-extrabold uppercase space-x-2 mb-8 mx-auto">
                        <span class="inline-flex whitespace-nowrap" style="display:inline-flex;white-space:nowrap;">
                            <span class="inline-block">Unlock</span>
                        </span>

                        <span class="inline-flex whitespace-nowrap" style="display:inline-flex;white-space:nowrap;">
                            <span class="inline-block">Growth</span>
                        </span>

                        <span class="inline-flex whitespace-nowrap" style="display:inline-flex;white-space:nowrap;">
                            <span class="inline-block">Every</span>
                        </span>

                        <span class="inline-flex whitespace-nowrap" style="display:inline-flex;white-space:nowrap;">
                            <span class="inline-block">Project</span>
                        </span>
                    </h1>
                    <p class="mb-8 text-md font-medium lg:text-xl slide-up-init">Start your freelancing career with us. Get started now by choosing a role.</p>
                    <div class="flex flex-col space-y-4 sm:flex-row sm:justify-start sm:space-y-0 sm:space-x-4">
                        <a asp-controller="Account" asp-action="Registration" asp-route-role="Client" class="border border-gray-300 bg-gray-100 hover:bg-gray-200 focus:outline-none focus:ring-4 focus:ring-gray-200 font-medium rounded-lg text-base px-7 py-2 me-2 mb-2 slide-up-init">Client</a>
                        <a asp-controller="Account" asp-action="Registration" asp-route-role="Freelancer" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-base px-8 py-2 me-2 mb-2 slide-up-init">Freelancer</a>
                    </div>
                </div>

                <div class="slide-up-init col-span-2 sm:col-span-1 relative">
                    <div class="flex justify-center">
                        <img src="https://ik.imagekit.io/6txj3mofs/Untitled%20design%20(4).png?updatedAt=1758106485550" class="w-full h-auto" />
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
          const letters = document.querySelectorAll('h1 .inline-flex > .inline-block');
          letters.forEach((el, i) => {
            el.style.animationDelay = (i * 0.2) + 's';
            el.classList.add('animate');
          });

          const slideElements = document.querySelectorAll('.slide-up-init');
            const base = 0.7;
            const stagger = 0.12;
            slideElements.forEach((el, i) => {
                el.style.animationDelay = (base + i * stagger) + 's';
                el.classList.add('animate');
            });
        });

        const openBtn = document.getElementById('openMenuBtn');
        const closeBtn = document.getElementById('closeMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        const backdrop = document.getElementById('menuBackdrop');

        function openMenu() {
          mobileMenu.classList.remove('hidden');
          document.documentElement.classList.add('overflow-hidden');
        }

        function closeMenu() {
          mobileMenu.classList.add('hidden');
          document.documentElement.classList.remove('overflow-hidden');
        }

        openBtn.addEventListener('click', openMenu);
        closeBtn.addEventListener('click', closeMenu);
        backdrop.addEventListener('click', closeMenu);

        mobileMenu.addEventListener('click', (e) => {
          const panel = mobileMenu.querySelector('.relative.mx-4');
          if (!panel.contains(e.target) && !e.target.closest('#openMenuBtn')) {
            closeMenu();
          }
        });

        document.addEventListener('keydown', e => {
          if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) closeMenu();
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/node_modules/flowbite/dist/flowbite.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.2.1/flowbite.min.js"></script>
</body>
</html>